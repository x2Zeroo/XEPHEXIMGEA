    -- สร้าง Writer สำหรับไฟล์รวมสคริปต์
    local combined
    if CONFIG.WRITE_COMBINED_SCRIPTS then
        combined = Writer.new(CONFIG.OUTPUT_DIR .. "/" .. CONFIG.COMBINED_FILE,
            "-- ============================================================\n" ..
            "-- ANIMAL HOSPITAL — ALL SCRIPTS COMBINED\n" ..
            "-- Generated: " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n" ..
            "-- Executor: " .. getExecutorName() .. "\n" ..
            "-- ============================================================\n\n")
    end

    local done = 0

    task.spawn(function()
        for _, r in ipairs(roots) do
            local svcName = r.name
            local sw = Writer.new(CONFIG.OUTPUT_DIR .. "/" .. svcName .. ".txt",
                "=== " .. svcName .. " ===\n" .. os.date("%Y-%m-%d %H:%M:%S") .. " (พบ " .. tostring(counts[svcName]) .. " รายการ)\n\n")
            print(string.format("[Dumper] ▶ กำลังดัมพ์ %s", svcName))

            local queue, head = { { r.inst, 0 } }, 1
            local svcDone, svcTotal, svcStart = 0, counts[svcName], os.clock()

            while head <= #queue do
                local sliceStart = nowMs()
                local processed = 0

                while head <= #queue do
                    local entry = queue[head]; head = head + 1
                    local inst, depth = entry[1], entry[2]

                    if inst and (inst.Parent ~= nil or depth == 0) then
                        local isTarget = false
                        for _, cls in ipairs(CONFIG.SCAN_CLASSES) do
                            if inst.ClassName == cls then
                                isTarget = true
                                break
                            end
                        end

                        if isTarget then
                            -- Render และ index
                            local ok = pcall(function()
                                local lines = renderInstance(inst, depth)
                                for _, ln in ipairs(lines) do
                                    sw:line(ln)
                                    if master then master:line(ln) end
                                end
                                indexInstance(inst)
                            end)
                            if not ok then
                                sw:line(string.rep(" ", depth) .. "[ERR reading instance]")
                            end

                            -- บันทึกไฟล์ .lua แยก (เฉพาะสคริปต์)
                            if CONFIG.DUMP_SCRIPT_SOURCE then
                                pcall(function()
                                    if inst:IsA("ModuleScript") or inst:IsA("Script") or inst:IsA("LocalScript") then
                                        writeScriptSource(inst)
                                        -- เพิ่มลงไฟล์รวม (ถ้าเปิด)
                                        if combined then
                                            local fullName = inst:GetFullName()
                                            local scriptPath = buildScriptPath(fullName)
                                            local executor = getExecutorName()
                                            local src = getScriptSource(inst) or "-- [Source not available]"
                                            combined:line("-- ============================================================")
                                            combined:line("-- Script Path: " .. scriptPath)
                                            combined:line("-- Executor: " .. executor)
                                            combined:line("-- ============================================================")
                                            combined:line(src)
                                            combined:line("")  -- บรรทัดว่างคั่น
                                        end
                                    end
                                end)
                            end

                            svcDone = svcDone + 1
                            done = done + 1
                            processed = processed + 1

                            if done % CONFIG.PROGRESS_EVERY == 0 then
                                local sp = svcTotal > 0 and (svcDone / svcTotal * 100) or 100
                                local ap = grand > 0 and (done / grand * 100) or 100
                                local el = os.clock() - startTime
                                local rate = el > 0 and (done / el) or 0
                                local eta = rate > 0 and ((grand - done) / rate) or 0
                                print(string.format(
                                    "[Dumper] 📈 %-16s %5.1f%% (%d/%d) | รวม %5.1f%% (%d/%d) | %.0f ตัว/วินาที | เหลือ %.0fs",
                                    svcName, sp, svcDone, svcTotal, ap, done, grand, rate, eta
                                ))
                            end
                        end

                        -- Traverse ลูกๆ
                        local okC, kids = pcall(function() return inst:GetChildren() end)
                        if okC and kids then
                            for _, c in ipairs(kids) do
                                queue[#queue + 1] = { c, depth + 1 }
                            end
                        end
                    end

                    if processed >= CONFIG.MIN_BATCH then
                        if processed >= CONFIG.MAX_BATCH or (nowMs() - sliceStart) >= CONFIG.FRAME_BUDGET_MS then
                            break
                        end
                    end
                end

                sw:flush()
                if master then master:flush() end
                if combined then combined:flush() end
                task.wait()
            end

            sw:line(string.format("\n=== %s เสร็จ — %d ออบเจ็กต์, %.2fs ===", svcName, svcDone, os.clock() - svcStart))
            sw:flush()
            print(string.format("[Dumper] ✔ %s — %d ออบเจ็กต์ ใน %.2fs", svcName, svcDone, os.clock() - svcStart))
        end

        if master then
            master:line(string.format("\n=== MASTER DONE — %d instances, %.2fs ===", done, os.clock() - startTime))
            master:flush()
        end

        if combined then
            combined:line("-- ============================================================")
            combined:line("-- END OF ALL SCRIPTS")
            combined:flush()
        end

        -- เขียน SEARCH INDEXES
        print("[Dumper] 📝 กำลังเขียนดัชนีค้นหา...")
        local summaryLines = {
            "=== ANIMAL HOSPITAL SEARCH INDEX (เฉพาะคลาสที่กำหนด) ===",
            os.date("%Y-%m-%d %H:%M:%S"),
            "",
        }
        for _, cat in ipairs(INDEX_ORDER) do
            local arr = index[cat]
            if arr and #arr > 0 then
                table.sort(arr)
                local iw = Writer.new(CONFIG.OUTPUT_DIR .. "/INDEX_" .. cat .. ".txt",
                    "=== INDEX: " .. cat .. " ===\nCount: " .. #arr .. "\n\n")
                for _, ln in ipairs(arr) do
                    iw:line(ln)
                end
                iw:flush()
                summaryLines[#summaryLines + 1] = string.format("%-20s %d", cat, #arr)
                print(string.format("[Dumper] 📄 INDEX_%-18s %d", cat, #arr))
            end
        end

        local sumW = Writer.new(CONFIG.OUTPUT_DIR .. "/INDEX_SUMMARY.txt",
            table.concat(summaryLines, "\n") .. "\n")
        sumW:flush()

        local total = os.clock() - startTime
        print("╔════════════════════════════════════════════════╗")
        print(string.format("║ ✅ เสร็จสิ้น — %d ออบเจ็กต์ ใน %.2fs", done, total))
        print("║ 📂 ไฟล์อยู่ใน : " .. CONFIG.OUTPUT_DIR .. "/")
        print("║ 📜 สคริปต์ (ไฟล์ .lua) อยู่ใน : " .. CONFIG.OUTPUT_DIR .. "/Scripts/ (มี Header)")
        if CONFIG.WRITE_COMBINED_SCRIPTS then
            print("║ 📦 ไฟล์รวมสคริปต์: " .. CONFIG.OUTPUT_DIR .. "/" .. CONFIG.COMBINED_FILE)
        end
        if CONFIG.EMBED_SOURCE_IN_TEXT then
            print("║ 📝 เนื้อหาสคริปต์ถูกฝังในไฟล์ .txt ด้วย")
        end
        print("║ 🏁 เริ่มต้นที่ : INDEX_SUMMARY.txt")
        print("╚════════════════════════════════════════════════╝")
    end)

    print("[Dumper] ⏳ กำลังทำงานเบื้องหลัง — ดูคอนโซลเพื่อดูความคืบหน้า")
end

startDump()