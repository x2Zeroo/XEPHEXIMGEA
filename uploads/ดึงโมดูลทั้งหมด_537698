    end
    print("[Dumper] 📊 กำลังค้นหา " .. #roots .. " บริการ")

    -- Pass 1: นับจำนวนเฉพาะคลาสที่ตรง
    print("[Dumper] Pass 1/2 — กำลังนับจำนวน...")
    local counts, grand = {}, 0
    for _, r in ipairs(roots) do
        local count = 0
        local function countDescendants(inst)
            for _, child in ipairs(inst:GetChildren()) do
                for _, cls in ipairs(CONFIG.SCAN_CLASSES) do
                    if child.ClassName == cls then
                        count = count + 1
                        break
                    end
                end
                countDescendants(child)
            end
        end
        countDescendants(r.inst)
        counts[r.name] = count
        grand = grand + count
        print(string.format("[Dumper] 📁 %-20s %d ออบเจ็กต์ที่ตรง", r.name, count))
    end
    print(string.format("[Dumper] 📊 รวมทั้งหมดที่ตรง: %d ออบเจ็กต์", grand))

    if grand == 0 then
        print("[Dumper] ⚠️ ไม่พบออบเจ็กต์ที่ตรงกับ SCAN_CLASSES ในบริการที่เลือก")
