-- ─────────────────────────────────────────────
-- GET SCRIPT SOURCE (พยายามหลายวิธี แบบ Dex)
-- ─────────────────────────────────────────────
local function getScriptSource(inst)
    -- 1. getscriptsource (Executor API)
    local ok, src = pcall(function() return getscriptsource(inst) end)
    if ok and src and src ~= "" then
        return src
    end

    -- 2. decompile (วิธีที่ Dex ใช้) ⭐
    local env = getfenv and getfenv() or _G
    local decompile = env.decompile or rawget(env, "decompile")
    if decompile then
        ok, src = pcall(decompile, inst)
        if ok and src and src ~= "" then
            return src
        end
    end

    -- 3. inst.Source (Roblox property)
    ok, src = pcall(function() return inst.Source end)
    if ok and src and src ~= "" then
        return src
    end

    -- 4. getbytecode (Executor API)
    local ok2, bc = pcall(function() return getbytecode(inst) end)
    if ok2 and bc then
        local ok3, converted = pcall(function()
            if type(bc) == "string" then
                return bc
            elseif type(bc) == "table" then
                local parts = {}
                for _, v in ipairs(bc) do
                    parts[#parts + 1] = string.char(v)
                end
                return table.concat(parts)
            end
        end)
        if ok3 and converted and converted ~= "" then
            return converted
        end
    end

    return nil
end

-- ─────────────────────────────────────────────
-- BUILD SCRIPT PATH (game:GetService(...).child...)
-- ─────────────────────────────────────────────
local function buildScriptPath(path)
    local parts = {}
    for part in string.gmatch(path, "[^%.]+") do
        table.insert(parts, part)
    end
    if #parts == 0 then return path end
    local service = parts[1]
    local result = 'game:GetService("' .. service .. '")'
    for i = 2, #parts do
        result = result .. '.' .. parts[i]
    end
    return result
end

-- ─────────────────────────────────────────────
-- WRITE SCRIPT SOURCE (ไฟล์ .lua แยก)
-- ─────────────────────────────────────────────
local function writeScriptSource(inst)
    if not CONFIG.DUMP_SCRIPT_SOURCE then return end
    local src = getScriptSource(inst)
    if not src then
        src = "-- [Source not available]"
    end

    local fullName = inst:GetFullName()
    local relPath = string.gsub(fullName, "%.", "/") .. ".lua"
    local fullPath = CONFIG.OUTPUT_DIR .. "/Scripts/" .. relPath
    local dir = fullPath:match("(.*)/")
    if dir then
        ensureDir(dir)
    end

    local scriptPath = buildScriptPath(fullName)
    local executor = getExecutorName()
    local header = string.format(
        "-- Script Path: %s\n-- Took 0s to decompile.\n-- Executor: %s\n\n",
        scriptPath,
        executor
    )

    pcall(_writefile, fullPath, header .. src)
end

-- ─────────────────────────────────────────────
-- RENDER ONE INSTANCE (ฝังเนื้อหาถ้าเปิด)
-- ─────────────────────────────────────────────
local function renderInstance(inst, depth)
    local indent = string.rep(" ", depth)
    local okPath, full = pcall(function() return inst:GetFullName() end)
    local head = indent .. "[" .. inst.ClassName .. "] " .. inst.Name .. " (" .. (okPath and full or "?") .. ")"
    local lines = { head }

    if CONFIG.DUMP_FULL_PROPS then
        local props, order = getProps(inst)
        for _, k in ipairs(order) do
            lines[#lines + 1] = indent .. " ." .. k .. " = " .. props[k]
        end
    end

    -- จัดการสคริปต์
    if CONFIG.DUMP_SCRIPT_SOURCE and (inst:IsA("ModuleScript") or inst:IsA("Script") or inst:IsA("LocalScript")) then
        local relPath = string.gsub(inst:GetFullName(), "%.", "/") .. ".lua"
        if CONFIG.EMBED_SOURCE_IN_TEXT then
            local src = getScriptSource(inst)
            if src then
                lines[#lines + 1] = indent .. " .Source ="
                for line in string.gmatch(src, "([^\n]*)\n?") do
                    if line ~= "" then
                        lines[#lines + 1] = indent .. "     " .. line
                    end
                end
                lines[#lines + 1] = indent .. " .SourceFile = Scripts/" .. relPath
            else
                lines[#lines + 1] = indent .. " .Source = [Source not available]"
                lines[#lines + 1] = indent .. " .SourceFile = Scripts/" .. relPath
            end
        else
            lines[#lines + 1] = indent .. " .Source = [saved to Scripts/" .. relPath .. "]"
        end
    end

    return lines
end

