local INDEX_ORDER = {}
for _, cls in ipairs(CONFIG.SCAN_CLASSES) do
    local cat = INDEX_MAP[cls]
    if cat and not table.find(INDEX_ORDER, cat) then
        table.insert(INDEX_ORDER, cat)
    end
end
if #INDEX_ORDER == 0 then
    INDEX_ORDER = {
        "ModuleScripts","Scripts","LocalScripts",
        "RemoteEvents","RemoteFunctions","BindableEvents","BindableFunctions",
        "ProximityPrompts","ClickDetectors",
        "Animations","Sounds","Tools","Values",
    }
end

local index = {}
for _, cat in ipairs(INDEX_ORDER) do index[cat] = {} end

local function indexInstance(inst)
    local cat = INDEX_MAP[inst.ClassName]
    if not cat then return end

    local path = inst:GetFullName()
    local extra = ""
    local cn = inst.ClassName

    if cn == "Animation" then
        local ok, id = pcall(function() return inst.AnimationId end)
        if ok then extra = " [" .. tostring(id) .. "]" end
    elseif cn == "Sound" then
        local ok, id = pcall(function() return inst.SoundId end)
        if ok then extra = " [" .. tostring(id) .. "]" end
    elseif cat == "Values" then
        local ok, val = pcall(function() return inst.Value end)
        if ok then extra = " = " .. ser(val) end
    elseif cn == "ProximityPrompt" then
        local ok, txt = pcall(function() return inst.ActionText end)
        if ok then extra = " \"" .. tostring(txt) .. "\"" end
    end

    if CONFIG.DUMP_SCRIPT_SOURCE and (cn == "ModuleScript" or cn == "Script" or cn == "LocalScript") then
        local relPath = string.gsub(inst:GetFullName(), "%.", "/") .. ".lua"
        extra = extra .. " [src: Scripts/" .. relPath .. "]"
    end

    local arr = index[cat]
    arr[#arr + 1] = "[" .. cn .. "] " .. path .. extra
end

-- ─────────────────────────────────────────────
-- UTILITY: ensure directory exists
-- ─────────────────────────────────────────────
local function ensureDir(path)
    if not path or path == "" then return end
    local parts = {}
    for part in string.gmatch(path, "[^/]+") do
        table.insert(parts, part)
    end
    local current = ""
    for i = 1, #parts do
        current = current .. parts[i] .. "/"
        if not _isfolder(current) then
            pcall(_makefolder, current)
        end
    end
end

