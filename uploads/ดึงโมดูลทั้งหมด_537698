-- ─────────────────────────────────────────────
-- PROPERTY EXTRACTION
-- ─────────────────────────────────────────────
local function getProps(inst)
    local props, order = {}, {}
    local seen = {}
    local function put(k, v)
        if v == nil or seen[k] then return end
        seen[k] = true
        props[k] = ser(v)
        order[#order + 1] = k
    end

    for _, name in ipairs(EXPLOIT_PROPS) do
        if name == "Source" and (inst:IsA("ModuleScript") or inst:IsA("Script") or inst:IsA("LocalScript")) then
            -- ข้าม Source เพื่อไม่ให้แสดงใน properties ปกติ
        else
            local ok, val = pcall(function() return inst[name] end)
            if ok and val ~= nil then
                put(name, val)
            end
        end
    end

    local okA, attrs = pcall(function() return inst:GetAttributes() end)
    if okA and attrs then
        for k, v in pairs(attrs) do
            put("@" .. k, v)
        end
    end

    local okT, tags = pcall(function() return CollectionSvc:GetTags(inst) end)
    if okT and tags and #tags > 0 then
        props["#Tags"] = table.concat(tags, ", ")
        order[#order + 1] = "#Tags"
    end

    return props, order
end

-- ─────────────────────────────────────────────
-- BUFFERED WRITER
-- ─────────────────────────────────────────────
local Writer = {}
Writer.__index = Writer
function Writer.new(path, header)
    local self = setmetatable({ path = path, buf = {}, n = 0 }, Writer)
    pcall(_writefile, path, header or "")
    return self
end
function Writer:line(s)
    self.n = self.n + 1
    self.buf[self.n] = s
    if self.n >= CONFIG.FLUSH_THRESHOLD then
        self:flush()
    end
end
function Writer:flush()
    if self.n == 0 then return end
    pcall(_appendfile, self.path, table.concat(self.buf, "\n") .. "\n")
    self.buf, self.n = {}, 0
end

