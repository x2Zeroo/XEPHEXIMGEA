-- ── Shared Queue System ──
local isWorking = false
local workQueue = {}

local function enqueueWork(fn)
    table.insert(workQueue, fn)
end

local function runQueue()
    task.spawn(function()
        while true do
            if #workQueue > 0 and not isWorking then
                isWorking = true
                local fn = table.remove(workQueue, 1)
                fn()
                isWorking = false
            end
            task.wait(0.1)
        end
    end)
end
runQueue()

-- ── Check In ──
local CheckInSec = TabMain:Section({
    Title = "Check In",
    Icon = "clipboard-list",
    Box = true,
    TextSize = 18,
    Opened = false
})

local checkInThread
local TogCheckIn = CheckInSec:Toggle({
    Title = "Auto Check In",
    Icon = "map-pin",
    Desc = "ออโต้เช็คอิน",
    Default = false,
    Callback = function(state)
        if state then
            checkInThread = task.spawn(function()
                local character = LocalPlr.Character or LocalPlr.CharacterAdded:Wait()
                local hrp = character:WaitForChild("HumanoidRootPart")

                local sequence = {
                    {path = {"Misc", "CheckIn", "Form"}, label = "ฟอร์ม"},
                    {path = {"Misc", "CheckIn", "Camera"}, label = "กล้อง"},
                    {path = {"Misc", "CheckIn", "Computer"}, label = "คอมพิวเตอร์"},
                    {path = {"Misc", "CheckIn", "Printer"}, label = "เครื่องปริ้น"},
                    {path = {"Misc", "CheckIn", "PrintedBadge"}, label = "บัตร"},
                    {path = {"NPCs"}, scanChildren = true, label = "NPC"},
                }

                local function getObject(entry)
                    local obj = workspace
                    for _, key in ipairs(entry.path) do
                        obj = obj:FindFirstChild(key)
                        if not obj then return nil end
                    end
                    return obj
                end

                local function getPartFromParent(parent)
                    if parent:IsA("BasePart") then return parent end
                    if parent:IsA("Model") then
                        return parent.PrimaryPart or parent:FindFirstChildOfClass("BasePart")
                    end
                    return parent:FindFirstChildOfClass("BasePart")
                end

                local function findNearestNPCWithPP(folder, referencePos)
                    local nearestNPC, nearestPP, nearestDist = nil, nil, math.huge
                    for _, child in ipairs(folder:GetChildren()) do
                        local pp = child:FindFirstChild("PP")
                        if not pp then
                            for _, desc in ipairs(child:GetDescendants()) do
                                if desc.Name == "PP" and desc:IsA("ProximityPrompt") then
                                    pp = desc
                                    break
                                end
                            end
                        end
                        if pp and pp:IsA("ProximityPrompt") then
                            local part = child.PrimaryPart or child:FindFirstChildOfClass("BasePart")
                            if part then
                                local dist = (part.Position - referencePos).Magnitude
                                if dist < nearestDist then
                                    nearestDist = dist
                                    nearestNPC = child
                                    nearestPP = pp
                                end
                            end
                        end
                    end
                    return nearestNPC, nearestPP
                end

                local function teleportTo(part)
                    hrp.CFrame = part.CFrame * CFrame.new(0, 0, -3)
                    task.wait(0.2)
                end

                local formPos = nil

                while true do
                    local done = false
                    enqueueWork(function()
                        for _, entry in ipairs(sequence) do
                            local parent = nil
                            repeat
                                parent = getObject(entry)
                                if not parent then task.wait(1) end
                            until parent

                            local pp, part = nil, nil

                            if entry.scanChildren then
                                local ref = formPos or Vector3.new(0, 0, 0)
                                local npc
                                repeat
                                    npc, pp = findNearestNPCWithPP(parent, ref)
                                    if not pp then task.wait(0.5) end
                                until pp
                                part = getPartFromParent(npc)
                            else
                                repeat
                                    pp = parent:FindFirstChild("PP")
                                    if not pp then task.wait(0.5) end
                                until pp
                                part = getPartFromParent(parent)

                                if entry.label == "ฟอร์ม" and part then
                                    formPos = part.Position
                                end
                            end

                            if part then teleportTo(part) end
                            task.wait(0.3)
                            fireproximityprompt(pp)
                            task.wait(1.5)
                        end
                        done = true
                    end)

                    repeat task.wait(0.1) until done
                    task.wait(3)
                end
            end)
        else
            if checkInThread then
                task.cancel(checkInThread)
                checkInThread = nil
            end
        end
    end
})
MyConfig:Register("AutoCheckIn", TogCheckIn)

-- ── Medical ──
local MedicalSec = TabMain:Section({
    Title = "Medical",
    Icon = "stethoscope",
    Box = true,
    TextSize = 18,
    Opened = false
})

local medicalThread
local TogMedical = MedicalSec:Toggle({
    Title = "Auto Medical",
    Icon = "heart-pulse",
    Desc = "ออโต้ทำ Medical",
    Default = false,
    Callback = function(state)
        if state then
            print("[Medical] ═══ เริ่มระบบ Auto Medical ═══")
            medicalThread = task.spawn(function()
                local char = LocalPlr.Character or LocalPlr.CharacterAdded:Wait()
                local hrp = char:WaitForChild("HumanoidRootPart")
                local humanoid = char:WaitForChild("Humanoid")
                print("[Medical] โหลดตัวละครสำเร็จ พร้อมเริ่มทำงาน")

                local npcFolder = workspace:FindFirstChild("NPCs")
                local doneRooms = {}

                -- คืนค่า stage ปัจจุบันของห้อง
                -- "waiting" หมายถึงยังไม่มี prompt ไหน enable ตอนนี้ (ต้องรอต่อ ไม่ใช่ done ทันที)
                local function getRoomStage(roomKey, npc)
                    local roomData = workspace.Rooms.Medical:FindFirstChild(roomKey)
                    if not roomData then return "invalid" end
                    local minigame = roomData:FindFirstChild("Minigame")
                    if not minigame then return "invalid" end

                    local npcPP = npc:FindFirstChild("PP")

                    local analyzer = minigame:FindFirstChild("Analyzer")
                    local analyzerPP = analyzer and analyzer:FindFirstChild("PP")

                    local monitor = minigame:FindFirstChild("Monitor")
                    local monitorPP2 = monitor and monitor:FindFirstChild("PP2")

                    local bed = minigame:FindFirstChild("Bed")
                    local inBed = bed and bed:FindFirstChild("InBed")
                    local bedPP = inBed and inBed:FindFirstChild("PP")

                    local tv = minigame:FindFirstChild("TV")
                    local hasItems = false
                    if tv then
                        local screen = tv:FindFirstChild("Screen")
                        local ui = screen and screen:FindFirstChild("UI")
                        local report = ui and ui:FindFirstChild("Report")
                        local inv = report and report:FindFirstChild("inv")
                        if inv then
                            for _, frame in ipairs(inv:GetChildren()) do
                                if frame:IsA("Frame") then
                                    hasItems = true
                                    break
                                end
                            end
                        end
                    end

                    if npcPP and npcPP:IsA("ProximityPrompt") and npcPP.Enabled then
                        return "npc"
                    elseif analyzerPP and analyzerPP:IsA("ProximityPrompt") and analyzerPP.Enabled then
                        return "analyzer"
                    elseif monitorPP2 and monitorPP2:IsA("ProximityPrompt") and monitorPP2.Enabled then
                        return "monitor"
                    elseif hasItems then
                        return "collect"
                    elseif bedPP and bedPP:IsA("ProximityPrompt") and bedPP.Enabled then
                        return "use"
                    else
                        return "waiting"
                    end
                end

                -- รอจน stage เปลี่ยนจากค่าปัจจุบัน (ใช้หลังกด prompt แล้ว)
                local function waitForStageChange(roomKey, npc, currentStage, maxWait)
                    local waited = 0
                    while waited < maxWait do
                        task.wait(0.2)
                        waited = waited + 0.2
                        local newStage = getRoomStage(roomKey, npc)
                        if newStage ~= currentStage then
                            print("[Medical] ห้อง " .. roomKey .. " → stage เปลี่ยนจาก '" .. currentStage .. "' เป็น '" .. newStage .. "' (ใช้เวลา " .. string.format("%.1f", waited) .. " วิ)")
                            return newStage
                        end
                    end
                    warn("[Medical] ห้อง " .. roomKey .. " → รอ " .. maxWait .. " วิแล้ว stage ยังคงเป็น '" .. currentStage .. "' (อาจติดขัด)")
                    return currentStage
                end

                -- บังคับรอจนกว่า prompt ถัดไปจะ enable จริง (ไม่ตัดสินว่า done จนกว่าจะรอครบเวลาสูงสุด)
                local function waitUntilNextStageOrDone(roomKey, npc, maxWait)
                    local waited = 0
                    local newStage = "waiting"
                    while waited < maxWait do
                        task.wait(0.3)
                        waited = waited + 0.3
                        newStage = getRoomStage(roomKey, npc)
                        if newStage ~= "waiting" then
                            print("[Medical] ห้อง " .. roomKey .. " → เจอ stage ใหม่: '" .. newStage .. "' (รอไป " .. string.format("%.1f", waited) .. " วิ)")
                            return newStage
                        end
                    end
                    print("[Medical] ห้อง " .. roomKey .. " → รอครบ " .. maxWait .. " วิแล้ว ไม่มี prompt ไหน enable เลย ถือว่าห้องนี้เสร็จสมบูรณ์จริง")
                    return "done"
                end

                while true do
                    local done = false
                    enqueueWork(function()
                        local ok, err = pcall(function()
                            if npcFolder then
                                for roomKey, data in pairs(doneRooms) do
                                    local npcRoot = data.npc:FindFirstChild("HumanoidRootPart") or data.npc:FindFirstChildWhichIsA("BasePart", true)
                                    if npcRoot then
                                        if (data.bedPart.Position - npcRoot.Position).Magnitude > 2 then
                                            print("[Medical] ห้อง " .. roomKey .. " → NPC ออกจากเตียงแล้ว รีเซ็ตห้องนี้")
                                            doneRooms[roomKey] = nil
                                        end
                                    else
                                        print("[Medical] ห้อง " .. roomKey .. " → หา NPC ไม่เจอ รีเซ็ตห้องนี้")
                                        doneRooms[roomKey] = nil
                                    end
                                end

                                for _, npc in ipairs(npcFolder:GetChildren()) do
                                    for i = 1, 8 do
                                        local roomKey = "Room" .. i
                                        if doneRooms[roomKey] then continue end

                                        local roomPath = workspace.Rooms.Medical:FindFirstChild(roomKey)
                                        if not roomPath then continue end

                                        local bed = roomPath:FindFirstChild("Minigame") and roomPath.Minigame:FindFirstChild("Bed")
                                        local inBed = bed and bed:FindFirstChild("InBed")
                                        local bedPP = inBed and inBed:FindFirstChild("PP")
                                        if not bedPP then continue end

                                        local bedPart = bed:FindFirstChildWhichIsA("BasePart", true)
                                        local npcRoot = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart", true)
                                        if not bedPart or not npcRoot then continue end

                                        local dist = (bedPart.Position - npcRoot.Position).Magnitude
                                        if dist > 2 then continue end

                                        local stage = getRoomStage(roomKey, npc)
                                        print("[Medical] ห้อง " .. roomKey .. " → NPC: " .. npc.Name .. " | stage ปัจจุบัน: '" .. stage .. "'")
                                        local room = workspace.Rooms.Medical[roomKey]
                                        local minigame = room:FindFirstChild("Minigame")

                                        if not minigame then
                                            warn("[Medical] ห้อง " .. roomKey .. " → ไม่พบ Minigame ข้ามห้องนี้")
                                            continue
                                        end

                                        if stage == "npc" then
                                            print("[Medical] ห้อง " .. roomKey .. " → กำลังไปหา NPC เพื่อกด PP")
                                            hrp.CFrame = bedPart.CFrame + Vector3.new(0, 3, 0)
                                            task.wait(0.3)
                                            print("[Medical] ห้อง " .. roomKey .. " → เทเลพอร์ตถึง NPC แล้ว")

                                            local npcPP = npc:FindFirstChild("PP")
                                            if npcPP and npcPP.Enabled then
                                                print("[Medical] ห้อง " .. roomKey .. " → พบ PP ของ NPC กำลังกด...")
                                                local ok2, err2 = pcall(function()
                                                    fireproximityprompt(npcPP)
                                                end)
                                                if ok2 then
                                                    print("[Medical] ห้อง " .. roomKey .. " → กด PP ของ NPC สำเร็จ")
                                                else
                                                    warn("[Medical] ห้อง " .. roomKey .. " → กด PP ของ NPC ล้มเหลว: " .. tostring(err2))
                                                end
                                            else
                                                print("[Medical] ห้อง " .. roomKey .. " → ไม่พบ PP หรือ PP ปิดอยู่แล้ว (ข้าม)")
                                            end

                                            print("[Medical] ห้อง " .. roomKey .. " → รอให้ stage เปลี่ยนจาก 'npc'...")
                                            waitForStageChange(roomKey, npc, "npc", 5)

                                        elseif stage == "analyzer" then
                                            print("[Medical] ห้อง " .. roomKey .. " → กำลังไปที่ Analyzer")
                                            local analyzer = minigame:FindFirstChild("Analyzer")
                                            if not analyzer then
                                                warn("[Medical] ห้อง " .. roomKey .. " → ไม่พบ instance 'Analyzer' ข้าม stage นี้")
                                            else
                                                local analyzerPart = analyzer:FindFirstChildWhichIsA("BasePart", true)
                                                if analyzerPart then
                                                    hrp.CFrame = analyzerPart.CFrame + Vector3.new(0, 3, 0)
                                                    task.wait(0.3)
                                                    print("[Medical] ห้อง " .. roomKey .. " → เทเลพอร์ตถึง Analyzer แล้ว")
                                                else
                                                    warn("[Medical] ห้อง " .. roomKey .. " → หาตำแหน่ง Analyzer ไม่เจอ")
                                                end

                                                local analyzerPP = analyzer:FindFirstChild("PP")
                                                if analyzerPP and analyzerPP.Enabled then
                                                    print("[Medical] ห้อง " .. roomKey .. " → พบ PP ของ Analyzer กำลังกด...")
                                                    local ok2, err2 = pcall(function()
                                                        fireproximityprompt(analyzerPP)
                                                    end)
                                                    if ok2 then
                                                        print("[Medical] ห้อง " .. roomKey .. " → กด PP ของ Analyzer สำเร็จ")
                                                    else
                                                        warn("[Medical] ห้อง " .. roomKey .. " → กด PP ของ Analyzer ล้มเหลว: " .. tostring(err2))
                                                    end
                                                else
                                                    print("[Medical] ห้อง " .. roomKey .. " → ไม่พบ PP ของ Analyzer หรือปิดอยู่แล้ว (ข้าม)")
                                                end

                                                print("[Medical] ห้อง " .. roomKey .. " → รอให้ stage เปลี่ยนจาก 'analyzer'ทันที หลังกด...")
                                                local nextStage = waitUntilNextStageOrDone(roomKey, npc, 15)
                                                if nextStage == "done" then
                                                    print("[Medical] ห้อง " .. roomKey .. " → ยืนยันแล้วว่าห้องนี้เสร็จสมบูรณ์จริง (รอครบเวลาแล้วไม่มี prompt ต่อ)")
                                                    doneRooms[roomKey] = { npc = npc, bedPart = bedPart }
                                                end
                                            end

                                        elseif stage == "monitor" then
                                            print("[Medical] ห้อง " .. roomKey .. " → กำลังไปที่ Monitor")
                                            local monitor = minigame:FindFirstChild("Monitor")
                                            if not monitor then
                                                warn("[Medical] ห้อง " .. roomKey .. " → ไม่พบ instance 'Monitor' ข้าม stage นี้")
                                            else
                                                local monitorPart = monitor:FindFirstChildWhichIsA("BasePart", true)
                                                if monitorPart then
                                                    hrp.CFrame = monitorPart.CFrame + Vector3.new(0, 3, 0)
                                                    task.wait(0.3)
                                                    print("[Medical] ห้อง " .. roomKey .. " → เทเลพอร์ตถึง Monitor แล้ว")
                                                else
                                                    warn("[Medical] ห้อง " .. roomKey .. " → หาตำแหน่ง Monitor ไม่เจอ")
                                                end

                                                local monitorPP2 = monitor:FindFirstChild("PP2")
                                                if monitorPP2 and monitorPP2.Enabled then
                                                    print("[Medical] ห้อง " .. roomKey .. " → พบ PP2 ของ Monitor กำลังกด...")
                                                    local ok2, err2 = pcall(function()
                                                        fireproximityprompt(monitorPP2)
                                                    end)
                                                    if ok2 then
                                                        print("[Medical] ห้อง " .. roomKey .. " → กด PP2 ของ Monitor สำเร็จ")
                                                    else
                                                        warn("[Medical] ห้อง " .. roomKey .. " → กด PP2 ของ Monitor ล้มเหลว: " .. tostring(err2))
                                                    end
                                                else
                                                    print("[Medical] ห้อง " .. roomKey .. " → ไม่พบ PP2 ของ Monitor หรือปิดอยู่แล้ว (ข้าม)")
                                                end

                                                print("[Medical] ห้อง " .. roomKey .. " → รอให้ stage เปลี่ยนจาก 'monitor' หลังกด...")
                                                local nextStage = waitUntilNextStageOrDone(roomKey, npc, 15)
                                                if nextStage == "done" then
                                                    print("[Medical] ห้อง " .. roomKey .. " → ยืนยันแล้วว่าห้องนี้เสร็จสมบูรณ์จริง (รอครบเวลาแล้วไม่มี prompt ต่อ)")
                                                    doneRooms[roomKey] = { npc = npc, bedPart = bedPart }
                                                end
                                            end

                                        elseif stage == "collect" then
                                            print("[Medical] ห้อง " .. roomKey .. " → เริ่มเก็บไอเทมตาม Report")
                                            local tv = minigame:FindFirstChild("TV")
                                            local screen = tv and tv:FindFirstChild("Screen")
                                            local ui = screen and screen:FindFirstChild("UI")
                                            local report = ui and ui:FindFirstChild("Report")
                                            local inv = report and report:FindFirstChild("inv")

                                            if not inv then
                                                warn("[Medical] ห้อง " .. roomKey .. " → ไม่พบ Report inv ข้าม stage นี้")
                                            else
                                                local itemCount = 0
                                                for _, frame in ipairs(inv:GetChildren()) do
                                                    if frame:IsA("Frame") then
                                                        itemCount = itemCount + 1
                                                        local itemName = frame.Name
                                                        print("[Medical] ห้อง " .. roomKey .. " → ต้องเก็บไอเทม: " .. itemName)
                                                        local foundItem = false
                                                        for _, model in ipairs(workspace:GetChildren()) do
                                                            local items = model:FindFirstChild("Items")
                                                            if items then
                                                                local item = items:FindFirstChild(itemName)
                                                                if item then
                                                                    local main = item:FindFirstChild("Main")
                                                                    local pp = item:FindFirstChild("PP")
                                                                    if main and pp and pp:IsA("ProximityPrompt") then
                                                                        foundItem = true
                                                                        hrp.CFrame = main.CFrame + Vector3.new(0, 3, 0)
                                                                        task.wait(0.2)
                                                                        local ok2, err2 = pcall(function()
                                                                            fireproximityprompt(pp)
                                                                        end)
                                                                        if ok2 then
                                                                            print("[Medical] ห้อง " .. roomKey .. " → เก็บไอเทม '" .. itemName .. "' สำเร็จ")
                                                                        else
                                                                            warn("[Medical] ห้อง " .. roomKey .. " → เก็บไอเทม '" .. itemName .. "' ล้มเหลว: " .. tostring(err2))
                                                                        end
                                                                        task.wait(0.3)
                                                                        break
                                                                    end
                                                                end
                                                            end
                                                        end
                                                        if not foundItem then
                                                            warn("[Medical] ห้อง " .. roomKey .. " → หาไอเทม '" .. itemName .. "' ในโลกไม่เจอ")
                                                        end
                                                    end
                                                end
                                                print("[Medical] ห้อง " .. roomKey .. " → เก็บไอเทมครบ " .. itemCount .. " ชิ้นแล้ว")
                                            end

                                        elseif stage == "use" then
                                            print("[Medical] ห้อง " .. roomKey .. " → เริ่มขั้นตอนใช้ไอเทมกับเตียง")
                                            local tv = minigame:FindFirstChild("TV")
                                            local screen = tv and tv:FindFirstChild("Screen")
                                            local ui = screen and screen:FindFirstChild("UI")
                                            local report = ui and ui:FindFirstChild("Report")
                                            local inv = report and report:FindFirstChild("inv")
                                            local bedInBed = bed and bed:FindFirstChild("InBed")
                                            local bedPPFinal = bedInBed and bedInBed:FindFirstChild("PP")
                                            local target = bed and bed:FindFirstChildWhichIsA("BasePart", true)

                                            if not inv or not bedPPFinal then
                                                warn("[Medical] ห้อง " .. roomKey .. " → ไม่พบ inv หรือ bedPP ข้าม stage นี้")
                                            else
                                                if target then
                                                    hrp.CFrame = target.CFrame + Vector3.new(0, 5, 0)
                                                    task.wait(0.2)
                                                    humanoid.PlatformStand = false
                                                    humanoid.Sit = false
                                                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                                                    humanoid:ChangeState(Enum.HumanoidStateType.Running)
                                                    print("[Medical] ห้อง " .. roomKey .. " → เทเลพอร์ตถึงเตียง และรีเซ็ตสถานะตัวละครแล้ว")
                                                else
                                                    warn("[Medical] ห้อง " .. roomKey .. " → หาตำแหน่งเตียงไม่เจอ")
                                                end
                                                task.wait(0.5)

                                                for _, frame in ipairs(inv:GetChildren()) do
                                                    if frame:IsA("Frame") then
                                                        local itemName = frame.Name
                                                        local tool = LocalPlr.Backpack:FindFirstChild(itemName) or char:FindFirstChild(itemName)
                                                        if tool and tool:IsA("Tool") then
                                                            print("[Medical] ห้อง " .. roomKey .. " → สวมใส่ไอเทม: " .. itemName)
                                                            humanoid:EquipTool(tool)
                                                            task.wait(0.3)
                                                            local ok2, err2 = pcall(function()
                                                                fireproximityprompt(bedPPFinal)
                                                            end)
                                                            if ok2 then
                                                                print("[Medical] ห้อง " .. roomKey .. " → ใช้ไอเทม '" .. itemName .. "' กับเตียงสำเร็จ")
                                                            else
                                                                warn("[Medical] ห้อง " .. roomKey .. " → ใช้ไอเทม '" .. itemName .. "' กับเตียงล้มเหลว: " .. tostring(err2))
                                                            end
                                                            task.wait(0.5)
                                                        else
                                                            warn("[Medical] ห้อง " .. roomKey .. " → หาไอเทม '" .. itemName .. "' ใน Backpack/ตัวละครไม่เจอ")
                                                        end
                                                    end
                                                end

                                                print("[Medical] ห้อง " .. roomKey .. " → เสร็จสิ้นขั้นตอน 'use' รอยืนยันว่าจบจริง...")
                                                local nextStage = waitUntilNextStageOrDone(roomKey, npc, 15)
                                                if nextStage == "done" then
                                                    print("[Medical] ห้อง " .. roomKey .. " → ยืนยันแล้วว่าห้องนี้เสร็จสมบูรณ์จริง บันทึกเป็น done")
                                                    doneRooms[roomKey] = { npc = npc, bedPart = bedPart }
                                                else
                                                    print("[Medical] ห้อง " .. roomKey .. " → หลังใช้ไอเทม เจอ stage ใหม่: '" .. nextStage .. "' จะทำในรอบถัดไป")
                                                end
                                            end

                                        elseif stage == "waiting" then
                                            -- ไม่มี prompt ไหน enable ตอนนี้ ต้องบังคับรอจนกว่าจะมี หรือรอครบเวลาแล้วค่อยถือว่า done
                                            print("[Medical] ห้อง " .. roomKey .. " → ไม่มี prompt ไหน enable ตอนนี้ กำลังรอ...")
                                            local nextStage = waitUntilNextStageOrDone(roomKey, npc, 15)
                                            if nextStage == "done" then
                                                print("[Medical] ห้อง " .. roomKey .. " → ยืนยันแล้วว่าห้องนี้เสร็จสมบูรณ์จริง บันทึกเป็น done")
                                                doneRooms[roomKey] = { npc = npc, bedPart = bedPart }
                                            end

                                        elseif stage == "invalid" then
                                            warn("[Medical] ห้อง " .. roomKey .. " → หา Minigame/RoomData ไม่เจอ ข้ามห้องนี้ไปก่อน")
                                        end
                                    end
                                end
                            else
                                warn("[Medical] ไม่พบโฟลเดอร์ NPCs ใน workspace")
                            end
                        end)

                        if not ok then
                            warn("[Medical] ═══ เกิด Error ระหว่างทำงาน (ถูกดักไว้แล้ว ไม่ค้าง): " .. tostring(err) .. " ═══")
                        end

                        done = true
                    end)

                    repeat task.wait(0.1) until done
                    task.wait(3)
                end
            end)
        else
            print("[Medical] ═══ ปิดระบบ Auto Medical ═══")
            if medicalThread then
                task.cancel(medicalThread)
                medicalThread = nil
                print("[Medical] ยกเลิก thread เรียบร้อยแล้ว")
            end
        end
    end
})
MyConfig:Register("AutoMedical", TogMedical)
เจอสาเหตุแล้วครับ — นี่แหละตัวการ
workQueue เป็นคิวกลางที่ทั้ง CheckIn และ Medical ใช้ร่วมกัน แต่ runQueue() ประมวลผลได้ ทีละ 1 งานเท่านั้น (isWorking flag) ปัญหาคือ:
CheckIn มี loop ภายในตัวเองที่ยาวมาก (เดินเก็บ 6 จุดตามลำดับ พร้อม repeat...until ที่รอ object โผล่มา + task.wait หลายจุด) ซึ่งเป็นงาน 1 ชิ้นในคิว ที่ยึด isWorking = true ค้างอยู่นานมาก จนกว่า sequence ทั้งหมดจะจบ
ระหว่างนั้น Medical เรียก enqueueWork(...) ของตัวเองไปเข้าคิวรอ แต่ไม่มีทางได้ทำงานเลย เพราะ CheckIn ยังไม่ปล่อย isWorking
พอ CheckIn วนลูปตัวเอง (while true do enqueueWork(...) end + คิวรอ 3 วิ) มันจะยึดคิวสลับไปเรื่อยๆ แทบตลอดเวลา ทำให้ Medical แทบไม่มีโอกาสได้ทำงานเลย — ตรงกับอาการ "ไม่กด Analyzer เลย" ที่คุณเจอ
เข้าใจแล้ว Shared Queue System นี้ถูกออกแบบมาเพื่อป้องกัน 2 ระบบแย่งคุมตัวละครพร้อมกัน (teleport ชนกัน) แต่ผลข้างเคียงคือถ้าเปิดพร้อมกันทั้งคู่ ตัวที่ loop ยาวกว่าจะแย่ง CPU ไปหมด
ทางแก้ที่ตรงจุดที่สุด: ให้ทั้งสองระบบสลับคิวกันแฟร์ๆ แทนที่จะปล่อยให้ฝ่ายใดฝ่ายหนึ่งยึดยาว
วิธีที่ดีที่สุดคือไม่ยัด sequence ทั้งหมดของ CheckIn เป็นงานเดียว แต่แตกเป็นงานย่อยทีละขั้น เพื่อให้คิวสลับกันได้บ่อยขึ้น หรือถ้าไม่อยากแก้โครงสร้างเยอะ ให้เพิ่ม timeout กันงานใดงานหนึ่งยึดคิวนานเกินไป
