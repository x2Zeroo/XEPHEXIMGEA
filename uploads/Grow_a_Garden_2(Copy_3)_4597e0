            if PassesFilter(Plant) then
                table.insert(matched, Plant)
            end
        end
    end

    return matched
end

local function HarvestMyPlot()
    local matched = ScanMyPlants()
    for _, Plant in ipairs(matched) do
        HarvestPlant(Plant)
        task.wait(0.05)
    end
end

