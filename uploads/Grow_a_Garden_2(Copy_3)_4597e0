local function NormalizeDropdownValue(v)
    if type(v) == "table" then
        local result = {}
        for _, item in ipairs(v) do
            if type(item) == "string" and item ~= "" then
                table.insert(result, item)
            end
        end
        return result
    elseif type(v) == "string" and v ~= "" then
        return { v }
    end
    return {}
end

local function IsFilterActive(selected)
    if #selected == 0 then return false end
    if table.find(selected, "None") then return false end
    return true
end

local knownMutations = { "Gold", "Rainbow", "Pizza", "Solarflare", "Chained", "Frozen", "Electric", "Starstruck", "Bloodlit" }

local function GetPlantMutations(Plant)
    local found = {}

    local mutAttr = Plant:GetAttribute("Mutation")
    if type(mutAttr) == "string" and mutAttr ~= "" then
        for word in string.gmatch(mutAttr, "[^%s,]+") do
            found[word] = true
        end
    end

    for _, mName in ipairs(knownMutations) do
        local v = Plant:GetAttribute(mName)
        if v == true or (type(v) == "string" and v ~= "" and v ~= "false") then
            found[mName] = true
        end
    end

    local Fruits = Plant:FindFirstChild("Fruits")
    if Fruits then
        for _, Fruit in ipairs(Fruits:GetChildren()) do
            local fMut = Fruit:GetAttribute("Mutation")
            if type(fMut) == "string" and fMut ~= "" then
                for word in string.gmatch(fMut, "[^%s,]+") do
                    found[word] = true
                end
            end
            for _, mName in ipairs(knownMutations) do
                if Fruit:GetAttribute(mName) == true then
                    found[mName] = true
                end
            end
        end
    end

    return found
end

local function PassesFilter(Plant)
    local seed = Plant:GetAttribute("SeedName")
    if not seed then return false end

    -- Fruit filter
    if IsFilterActive(selectedPlants) then
        if not table.find(selectedPlants, seed) then
            return false
        end
    elseif not table.find(customNames, seed) then
        return false
    end

    -- Rarity filter
    if IsFilterActive(selectedRarities) then
        local rarity = rarityMap[seed]
        if not rarity or not table.find(selectedRarities, rarity) then
            return false
        end
    end

    -- Mutation filter
    if IsFilterActive(selectedMutations) then
        local plantMuts = GetPlantMutations(Plant)
        local matched = false
        for _, want in ipairs(selectedMutations) do
            if plantMuts[want] then
                matched = true
                break
            end
        end
        if not matched then
            return false
        end
    end

    -- Weight filter: เก็บเฉพาะต้นที่น้ำหนัก "ไม่ถึง" ค่าที่กรอก
    if maxWeightFilter then
        local weight = GetPlantWeight(Plant)
        if not weight or weight >= maxWeightFilter then
            return false
        end
    end

    return true
end

