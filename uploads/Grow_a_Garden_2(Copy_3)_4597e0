local function TimeLeft(unix)
	local diff = unix - os.time()

	if diff >= 0 then
		if diff < 60 then
			return ("อีก %d วินาที"):format(diff)
		end

		if diff < 3600 then
			return ("อีก %d นาที"):format(math.floor(diff / 60))
		end

		local h = math.floor(diff / 3600)
		local m = math.floor((diff % 3600) / 60)

		return ("อีก %d ชม. %d นาที"):format(h, m)
	end

	diff = math.abs(diff)

	if diff < 60 then
		return ("%d วินาทีที่แล้ว"):format(diff)
	end

	if diff < 3600 then
		return ("%d นาทีที่แล้ว"):format(math.floor(diff / 60))
	end

	local h = math.floor(diff / 3600)
	local m = math.floor((diff % 3600) / 60)

	return ("%d ชม. %d นาทีที่แล้ว"):format(h, m)
end

local function FormatUpdatedAt(updatedAt)
	local y, mo, d, h, mi, s =
		updatedAt:match("^(%d+)%-(%d+)%-(%d+)T(%d+):(%d+):(%d+)")

	if not y then
		return "-"
	end

	local utc = os.time({
		year = tonumber(y),
		month = tonumber(mo),
		day = tonumber(d),
		hour = tonumber(h),
		min = tonumber(mi),
		sec = tonumber(s)
	})

	return ThaiTime(utc)
end

local function FormatStock(stockData, updatedAt)
	local lines = {}

	local nextTime = stockData.nextRestockAt

	if nextTime then
		table.insert(lines, "📌 รีสต็อกรอบถัดไป")
		table.insert(lines, "เวลา " .. ThaiTime(nextTime))
		table.insert(lines, "")

		for _, item in ipairs(stockData.upcoming or {}) do
			if item.timestamp == nextTime then
				table.insert(
					lines,
					string.format(
						"• %s x%s",
						item.name,
						item.quantity or 1
					)
				)
			end
		end

		table.insert(lines, "")
		table.insert(lines, "━━━━━━━━━━")
		table.insert(lines, "")
		table.insert(lines, "สต็อกที่จะเข้าถัดไป")
		table.insert(lines, "")
	end

	for _, item in ipairs(stockData.upcoming or {}) do
		if item.timestamp ~= nextTime then
			table.insert(
				lines,
				string.format(
					"• %s x%s %s",
					item.name,
					item.quantity or 1,
					TimeLeft(item.timestamp)
				)
			)

			table.insert(
				lines,
				"เวลา " .. ThaiTime(item.timestamp)
			)

			table.insert(lines, "")
		end
	end

	table.insert(lines, "━━━━━━━━━━")
	table.insert(lines, "เวลาปัจจุบัน " .. ThaiNow())
	table.insert(lines, "อัปเดตล่าสุด " .. FormatUpdatedAt(updatedAt))

	return table.concat(lines, "\n")
end

local function FormatWeather(weatherData, updatedAt)
	local lines = {}

	for _, item in ipairs(weatherData or {}) do
		table.insert(
			lines,
			string.format(
				"• %s %s",
				item.name,
				TimeLeft(item.timestamp)
			)
		)

		table.insert(
			lines,
			"เวลา " .. ThaiTime(item.timestamp)
		)

		table.insert(lines, "")
	end

	table.insert(lines, "━━━━━━━━━━")
	table.insert(lines, "เวลาปัจจุบัน " .. ThaiNow())
	table.insert(lines, "อัปเดตล่าสุด " .. FormatUpdatedAt(updatedAt))

	return table.concat(lines, "\n")
end

