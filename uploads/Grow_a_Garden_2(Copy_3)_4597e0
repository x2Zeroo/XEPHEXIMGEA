local function GetSellableItems()
    local items = {}
    local sources = { Player.Backpack }
    if Player.Character then table.insert(sources, Player.Character) end

    for _, source in ipairs(sources) do
        for _, tool in ipairs(source:GetChildren()) do
            if not tool:IsA("Tool") then continue end

            local fruit    = tool:GetAttribute("Fruit") or tool:GetAttribute("FruitName")
            local mutation = tool:GetAttribute("Mutation") or "None"
            local weight   = tool:GetAttribute("Weight") or 0
            local id       = tool:GetAttribute("Id")

            if not (fruit and id) then continue end

            local fruitRarity = rarityMap[fruit] or "None"

            local fruitOk  = (SellConfig.FruitName == "None" or string.lower(fruit) == string.lower(SellConfig.FruitName))
            local mutOk    = (SellConfig.Mutation == "None" or string.lower(mutation) == string.lower(SellConfig.Mutation))
            local rarOk    = (SellConfig.Rarity == "None" or fruitRarity == SellConfig.Rarity)
            local weightOk = (SellConfig.MaxWeight <= 0 or weight <= SellConfig.MaxWeight)

            if fruitOk and mutOk and rarOk and weightOk then
                table.insert(items, { id = id })
            end
        end
    end
    return items
end

