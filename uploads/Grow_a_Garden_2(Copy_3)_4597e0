local function firePacket(packetName, itemName)
    local packetId = remote:GetAttribute(packetName)
    if not packetId then
        warn(packetName .. " not found")
        return
    end

    local b = buffer.create(2 + 1 + #itemName)
    buffer.writeu16(b, 0, packetId)
    buffer.writeu8(b, 2, #itemName)
    buffer.writestring(b, 3, itemName)

    remote:FireServer(b)
end

