-- Helper: เช็คว่า name อยู่ใน list ไหม
local function isInList(list, name)
    for _, v in ipairs(list) do
        if v == name then return true end
    end
    return false
end

-- Helper: loop ซื้อจาก stock
local function autoLoop(stockFolder, selectedList, buyFn, flagFn, allMode)
    task.spawn(function()
        while flagFn() do
            for _, stock in ipairs(stockFolder:GetChildren()) do
                if not flagFn() then break end
                if stock:IsA("ValueBase") and stock.Value > 0 then
                    if allMode or isInList(selectedList, stock.Name) then
                        for i = 1, stock.Value do
                            if not flagFn() then break end
                            buyFn(stock.Name)
                            task.wait()
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
end

