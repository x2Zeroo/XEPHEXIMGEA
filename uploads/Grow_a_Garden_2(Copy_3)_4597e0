-- ========== Random Position ==========

local function GetRandomPlotPosition()
    local Plot = GetMyPlot()
    if not Plot then
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            return hrp.Position + Vector3.new(math.random(-5, 5), 0, math.random(-5, 5))
        end
        return nil
    end

    -- ดึง BedSection ทั้งหมดจาก Visual
    local Visual = Plot:FindFirstChild("Visual")
    local bedSections = {}
    if Visual then
        for _, child in ipairs(Visual:GetChildren()) do
            if child.Name == "BedSection" then
                table.insert(bedSections, child)
            end
        end
    end

    -- ถ้าไม่มี BedSection ให้ fallback ใช้วิธีเดิม
    if #bedSections == 0 then
        local plotPart = Plot:FindFirstChildWhichIsA("BasePart")
        local center = plotPart and plotPart.Position
            or (LocalPlayer.Character and LocalPlayer.Character.HumanoidRootPart.Position)
            or Vector3.new(0, 0, 0)
        local size = plotPart and plotPart.Size or Vector3.new(20, 0, 20)
        return Vector3.new(
            center.X + math.random(-math.floor(size.X / 2), math.floor(size.X / 2)),
            center.Y,
            center.Z + math.random(-math.floor(size.Z / 2), math.floor(size.Z / 2))
        )
    end

    -- ดึง occupied positions จาก Plants
    local Plants = GetPlantsFolder(Plot)
    local occupiedPositions = {}
    for _, plant in ipairs(Plants:GetChildren()) do
        local rootPart = plant:FindFirstChild("HumanoidRootPart")
            or plant.PrimaryPart
            or plant:FindFirstChildWhichIsA("BasePart")
        if rootPart then
            table.insert(occupiedPositions, rootPart.Position)
        end
    end

    local function isOccupied(pos)
        for _, oPos in ipairs(occupiedPositions) do
            if (pos - oPos).Magnitude < 3 then return true end
        end
        return false
    end

    local function isSameAsLast(pos)
        return lastRandomPos and (pos - lastRandomPos).Magnitude < 3
    end

    -- สุ่มใน BedSection แบบสุ่ม BedSection ก่อน แล้วสุ่มตำแหน่งข้างใน
    for _ = 1, 30 do
        local bed = bedSections[math.random(1, #bedSections)]
        local bedPart = bed:FindFirstChildWhichIsA("BasePart") or bed

        local center, size
        if bedPart:IsA("BasePart") then
            center = bedPart.Position
            size = bedPart.Size
        else
            local cf, sz = bed:GetBoundingBox()
            center = cf.Position
            size = sz
        end

        local rx = center.X + math.random(-math.floor(size.X / 2), math.floor(size.X / 2))
        local rz = center.Z + math.random(-math.floor(size.Z / 2), math.floor(size.Z / 2))
        local pos = Vector3.new(rx, center.Y, rz)

        if not isOccupied(pos) and not isSameAsLast(pos) then
            lastRandomPos = pos
            return pos
        end
    end

    -- Fallback: สุ่มใน BedSection ใดก็ได้โดยไม่เช็ค occupied
    local bed = bedSections[math.random(1, #bedSections)]
    local cf, sz = bed:GetBoundingBox()
    local center = cf.Position
    local size = sz
    local pos = Vector3.new(
        center.X + math.random(-math.floor(size.X / 2), math.floor(size.X / 2)),
        center.Y,
        center.Z + math.random(-math.floor(size.Z / 2), math.floor(size.Z / 2))
    )
    lastRandomPos = pos
    return pos
end

