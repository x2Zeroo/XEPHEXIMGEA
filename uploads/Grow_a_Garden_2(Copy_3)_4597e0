-- ========== Plant ==========

local function plantSeed(seedName, position)
    if not position then return end

    local packetId = remote:GetAttribute("PlantSeed")
    local character = LocalPlayer.Character
    if not character then return end

    local backpack = LocalPlayer.Backpack
    local seedInstance = character:FindFirstChild(seedName)
        or backpack:FindFirstChild(seedName)
    if not seedInstance then return end

    local nameLen = #seedName
    local b = buffer.create(2 + 12 + 1 + nameLen)
    buffer.writeu16(b, 0, packetId)
    buffer.writef32(b, 2, position.X)
    buffer.writef32(b, 6, position.Y)
    buffer.writef32(b, 10, position.Z)
    buffer.writeu8(b, 14, nameLen)
    buffer.writestring(b, 15, seedName)

    remote:FireServer(b, {seedInstance})
end

