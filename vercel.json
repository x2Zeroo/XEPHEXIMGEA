{
  "version": 2,
  "functions": {
    "api/upload.js": { "maxDuration": 30 },
    "api/delete.js": { "maxDuration": 10 }
  },
  "rewrites": [
    {
      "source": "/api/upload",
      "destination": "/api/upload.js"
    },
    {
      "source": "/api/delete",
      "destination": "/api/delete.js"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/serve?path=uploads/:path*"
    }
  ]
}
