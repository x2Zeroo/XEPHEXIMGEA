	end,
	["on_unit_spawned"] = function(p_u_1, _) -- name: on_unit_spawned
		local v2 = p_u_1._root.Value._overhead
		v2.OverFrame.Health.Visible = false
		v2.OverFrame.Health:SetAttribute("_hidden", true)
		local v_u_3 = FX.MahoragaHealth:Clone()
		v_u_3.Parent = v2.OverFrame
		local function v7() -- name: _update_bar
			-- upvalues: (copy) v_u_3, (copy) p_u_1
			v_u_3.Mahoraga.front.Rotation = -90
			v_u_3.Mahoraga.back.Rotation = -90
			TweenService:Create(v_u_3.Mahoraga.front, TweenInfo.new(1, Enum.EasingStyle.Elastic), {
				["Rotation"] = 0
			}):Play()
			TweenService:Create(v_u_3.Mahoraga.back, TweenInfo.new(1, Enum.EasingStyle.Elastic), {
				["Rotation"] = 0
			}):Play()
			if p_u_1:GetAttribute("_mahoraga_completed") then
				v_u_3.Bar.healthbar.Size = UDim2.new(1, 0, 1, 0)
				v_u_3.Count.Text = "FULLY ADAPTED"
				v_u_3.Count.UIStroke.Color = Color3.fromHex("#A39230")
				v_u_3.UIStroke.Color = Color3.fromHex("#A39230")
				v_u_3.EvolvedGlow.Visible = true
				return
			else
				local v4 = p_u_1:GetAttribute("_mahoraga_takedowns") or 0
				local v5 = v4 / 50
				local v6 = math.clamp(v5, 0, 1)
				v_u_3.Bar.healthbar.Size = UDim2.new(v6, 0, 1, 0)
				v_u_3.Count.Text = string.format("%d/50", v4)
				if v4 >= 50 then
