-- ReplicatedStorage.src.client.Services.EffectScripts.sample [Script]
-- สคริปฝั่งเซิร์ฟ: โค้ดไม่ได้ส่งมาที่เครื่องเรา

-- ReplicatedStorage.src.client.Services.EffectScripts.0.7965907161 [ModuleScript]
return {
	["init_dependencies"] = function() -- name: init_dependencies
		Loader = require(game.ReplicatedStorage.src.Loader)
		Lighting = game:GetService("Lighting")
		TweenService = game:GetService("TweenService")
		Debris = game:GetService("Debris")
		FXUtil = Loader.load_client_service(script, "FXUtil")
		RunService = game:GetService("RunService")
		RandomGenerator = Loader.load_core_service(script, "RandomGenerator")
		ScaleParticle = require(game.ReplicatedStorage.imported.ScaleModel.ScaleParticle)
		LightningBolt = require(game.ReplicatedStorage.imported.LightningQuasi.new.LightningBolt)
		particles = Loader.get_assets_path().particles
		vfx = Loader.get_assets_path().vfx
	end,
	["start"] = function(_, p1, _) -- name: start
		local v2 = p1.unit
		local v3 = vfx.frieza_spawn_lazer:Clone()
		Debris:AddItem(v3, 1)
		FXUtil.play_nonpersistent_sound(v2.HumanoidRootPart, "Thunder_release")
		local v4 = v2._root.Value.CFrame
		local v5 = v2.HumanoidRootPart.Size.Z
		v3:SetPrimaryPartCFrame(v4 - Vector3.new(0, v5, 0))
		v3.Parent = workspace.ignore
		local v6 = LightningBolt.new(v3.Beam.Beam.Attachment, v3.Orb.Main.Attachment, 10)
		v6.PulseSpeed = 10
		v6.PulseLength = 1
		v6.Frequency = 0.4
		v6.FadeLength = 0.25
		v6.Thickness = 0.43199999999728
		v6.MinRadius = 0.86399999999456
		v6.MaxRadius = 1.2959999999918401
		v6.CurveSize0 = RandomGenerator.uniform_num(-4.3199999999728, 4.3199999999728)
		v6.CurveSize1 = RandomGenerator.uniform_num(-4.3199999999728, 4.3199999999728)
		v6.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(223, 92, 223)), ColorSequenceKeypoint.new(1, Color3.fromRGB(130, 80, 223)) })
		for _, v7 in pairs(v3:GetDescendants()) do
			if not v7:IsA("BasePart") then
				continue
			end
			local v8
			if v7.Color == Color3.fromRGB(180, 128, 255) then
				v8 = Color3.fromRGB(170, 0, 170)
			else
				v8 = Color3.fromRGB(107, 50, 124)
			end
			local v9 = v7.Parent == v3.Orb and 8 or 3
			TweenService:Create(v7, TweenInfo.new(1), {
				["Transparency"] = 1,
				["Color"] = nil,
				["Size"] = nil,
				["Color"] = v8,
				["Size"] = v7.Size * v9
			}):Play()
		end
		FXUtil.donut_shockwave(v3.PrimaryPart.CFrame, 5, Color3.fromRGB(170, 0, 170), Color3.fromRGB(180, 128, 255))
	end
}

