		local v2 = workspace._npcs.alluka
		local v3 = v2.nanika
		v3.black.Transparency = 1
		v3.white.Transparency = 1
		v2.headfake.Transparency = 0
		v2.headfake.Decal.Transparency = 0
		if p1.stage == "show_nanika" then
