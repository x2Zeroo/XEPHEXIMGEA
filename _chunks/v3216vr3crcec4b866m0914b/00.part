}

-- ReplicatedStorage.src.client.Services.MapScriptsClient.0.3467458027 [ModuleScript]
return {
	["init_dependencies"] = function() -- name: init_dependencies
		Loader = require(game.ReplicatedStorage.src.Loader)
		Util = require(game.ReplicatedStorage.src.Util)
		RunService = game:GetService("RunService")
	end,
	["init"] = function() -- name: init
		local v1 = workspace:WaitForChild("_map"):WaitForChild("_SPINWHEEL")
		while true do
			v1.CFrame = v1.CFrame * CFrame.Angles(0, 0, -0.005235987755982988)
			RunService.Heartbeat:Wait()
		end
	end
}

-- ReplicatedStorage.src.client.Services.MapScriptsClient.0.4315848604 [ModuleScript]
return {
	["init_dependencies"] = function() -- name: init_dependencies
		Loader = require(game.ReplicatedStorage.src.Loader)
		Util = require(game.ReplicatedStorage.src.Util)
		TweenService = game:GetService("TweenService")
	end,
	["init"] = function() -- name: init
		local v1 = workspace.floating_castle.main_rock
		TweenService:Create(v1, TweenInfo.new(5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, true), {
			["Position"] = v1.Position - Vector3.new(0, 10, 0)
		}):Play()
		for _, v2 in pairs(workspace.floating_castle.light_spikes:GetDescendants()) do
			if not v2:IsA("BasePart") then
				continue
			end
			v2.Anchored = true
			TweenService:Create(v2, TweenInfo.new(5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, true), {
				["Position"] = v2.Position - Vector3.new(0, 10, 0)
			}):Play()
		end
		for _, v3 in pairs(workspace.floating_castle.small_rocks:GetChildren()) do
			TweenService:Create(v3, TweenInfo.new(4, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, true), {
				["Position"] = v3.Position - Vector3.new(0, 3, 0)
			}):Play()
		end
		for _, v4 in pairs(workspace.floating_castle.small_light_spikes:GetDescendants()) do
			if not v4:IsA("BasePart") then
				continue
			end
			v4.Anchored = true
			TweenService:Create(v4, TweenInfo.new(4, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, true), {
				["Position"] = v4.Position - Vector3.new(0, 3, 0)
			}):Play()
		end
	end
}

-- ReplicatedStorage.src.client.Services.MapScriptsClient.0.2783252639 [ModuleScript]
return {
	["init_dependencies"] = function() -- name: init_dependencies
		Loader = require(game.ReplicatedStorage.src.Loader)
		Util = require(game.ReplicatedStorage.src.Util)
		TweenService = game:GetService("TweenService")
	end,
	["init"] = function() -- name: init
		local v1 = workspace._map.misc.portals
		for _, v2 in pairs(v1:GetChildren()) do
			if not v2:IsA("Model") then
				continue
			end
			local v3 = math.random(20, 30) / 10
			for _, v4 in pairs(v2:GetChildren()) do
				TweenService:Create(v4, TweenInfo.new(v3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, true), {
					["Position"] = v4.Position - Vector3.new(0, 10, 0)
				}):Play()
				local v5 = TweenService
				local v6 = TweenInfo.new(v3 * 2, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, true)
				local v7 = {}
				local v8 = v4.Size.X
				local v9 = v4.Size.Y * 0.8
				local v10 = v4.Size.Z
				v7.Size = Vector3.new(v8, v9, v10)
				v5:Create(v4, v6, v7):Play()
			end
		end
	end
}

