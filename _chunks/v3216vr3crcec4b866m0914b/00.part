			v2.headfake.Decal.Transparency = 1
			for _, v4 in pairs(v2:GetDescendants()) do
				if not v4:IsA("ParticleEmitter") or v4.Name ~= "DarkAura" then
					continue
				end
				v4.Enabled = true
			end
		elseif p1.stage == "revert_to_alluka" then
			v3.black.Transparency = 1
			v3.white.Transparency = 1
			v2.headfake.Transparency = 0
			v2.headfake.Decal.Transparency = 0
			for _, v5 in pairs(v2:GetDescendants()) do
				if not v5:IsA("ParticleEmitter") or v5.Name ~= "DarkAura" then
					continue
				end
				v5.Enabled = false
			end
		end
	end
}

