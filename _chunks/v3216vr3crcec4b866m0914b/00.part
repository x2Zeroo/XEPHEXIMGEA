-- ReplicatedStorage.src.client.Services.EffectScripts.0.7745192453 [ModuleScript]
return {
	["init_dependencies"] = function() -- name: init_dependencies
		Loader = require(game.ReplicatedStorage.src.Loader)
		FXUtil = Loader.load_client_service(script, "FXUtil")
		GameplaySettings = Loader.load_data(script, "GameplaySettings")
		UnitServiceCore = Loader.load_core_service(script, "UnitServiceCore")
		Lighting = game:GetService("Lighting")
		TweenService = game:GetService("TweenService")
		Debris = game:GetService("Debris")
		DodgedUI = Loader.get_assets_path().dodged_ui
		SFX = Loader.get_assets_path().sfx
	end,
	["start"] = function(_, p1, p2) -- name: start
		if not GameplaySettings.TRAILER_MODE then
			local v3 = p1.unit_char
			local v4 = 0
			if v3.HumanoidRootPart:FindFirstChild("dodged_ui") then
				task.wait(0.5)
				v4 = v4 + 1
				if v4 <= 10 then
					continue
				end
			end
			local v_u_5 = DodgedUI:Clone()
			Debris:AddItem(v_u_5, 3)
			v_u_5.Frame.GemCost.Text = p1.text
			v_u_5.Frame.GemCost.TextColor3 = p1.TextColor3
			v_u_5.Frame.GemCost.UIStroke.Color = p1.TextStrokeColor3
			if p2 and p2.create_new_part then
				local v6 = Instance.new("Part")
				v6.CanCollide = false
				v6.Anchored = true
				v6.Massless = true
				v6.Transparency = 1
				v6.CastShadow = false
				v6.Parent = workspace.ignore
				Debris:AddItem(v6, 3)
				v6.Size = v3.HumanoidRootPart.Size
				v6.CFrame = v3.HumanoidRootPart.CFrame
				v_u_5.Parent = v6
			else
				v_u_5.Parent = v3.HumanoidRootPart
			end
			v_u_5.ExtentsOffsetWorldSpace = Vector3.new(0, -2, 0)
			local v7 = v_u_5.StudsOffsetWorldSpace
			local v8 = UnitServiceCore.get_body_raise(v3)
			v_u_5.StudsOffsetWorldSpace = v7 + Vector3.new(0, v8, 0)
			v_u_5.Frame.GemCost.UIScale.Scale = 0.5
			local v9 = TweenService:Create(v_u_5.Frame.GemCost.UIScale, TweenInfo.new(0.2, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out, 0, false, 0), {
				["Scale"] = 1
			})
			TweenService:Create(v_u_5, TweenInfo.new(0.2), {
				["ExtentsOffsetWorldSpace"] = Vector3.new(0, 0, 0)
			}):Play()
			v9.Completed:Connect(function()
				-- upvalues: (copy) v_u_5
				task.wait(0.5)
				v_u_5.Name = "_debris"
				TweenService:Create(v_u_5.Frame.GemCost, TweenInfo.new(0.5), {
					["TextTransparency"] = 1,
					["TextStrokeTransparency"] = 1
				}):Play()
				TweenService:Create(v_u_5.Frame.GemCost.UIStroke, TweenInfo.new(0.5), {
					["Transparency"] = 1
				}):Play()
				TweenService:Create(v_u_5, TweenInfo.new(0.5), {
					["ExtentsOffsetWorldSpace"] = Vector3.new(0, 3, 0)
				}):Play()
			end)
			v9:Play()
		end
	end
}

