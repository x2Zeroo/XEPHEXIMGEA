		local v12 = v_u_1._gems_gained.Value
		v_u_11.Text = "+" .. tostring(v12)
		v_u_1._gems_gained.Changed:Connect(function(p13)
			-- upvalues: (copy) v_u_11
			v_u_11.Text = "+" .. tostring(p13)
		end)
		local v14 = v5.Info:WaitForChild("Buttons"):WaitForChild("Next")
