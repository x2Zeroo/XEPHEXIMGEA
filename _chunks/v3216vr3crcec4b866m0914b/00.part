-- ReplicatedStorage.src.client.Services.EffectScripts.0.9362644349 [ModuleScript]
return {
	["init_dependencies"] = function() -- name: init_dependencies
		Loader = require(game.ReplicatedStorage.src.Loader)
		ReplicatedStorage = game.ReplicatedStorage
		Lighting = game:GetService("Lighting")
		Players = game:GetService("Players")
		TweenService = game:GetService("TweenService")
		PhysicsService = game:GetService("PhysicsService")
		Debris = game:GetService("Debris")
		RunService = game:GetService("RunService")
		FXUtil = Loader.load_client_service(script, "FXUtil")
		FXServiceClient = Loader.load_client_service(script, "FXServiceClient")
		Units = Loader.load_data(script, "Units")
		SFX = Loader.get_assets_path().sfx
	end,
	["start"] = function(_, p1, _) -- name: start
		local v2 = p1.unit
		if p1.start then
			local v3 = Units[v2._stats.id.Value].stand
			v2:FindFirstChild("HumanoidRootPart")
			v2:FindFirstChild("Humanoid")
			local v4 = v2:FindFirstChild(v3)
			local v5 = {}
			for _, v6 in pairs({
				"Head",
				"Right Arm",
				"Left Arm",
				"Right Leg",
				"Left Leg",
				"Torso"
			}) do
				local v7 = v4[v6].aura:Clone()
				v7.Name = "_stand_aura"
				v7.Enabled = true
				v7.Parent = v2[v6]
				table.insert(v5, v7)
			end
			FXUtil.get_persistent_fx_data(v2).auras = v5
		else
			local v8 = FXUtil.get_persistent_fx_data(v2).auras
			if v8 == nil then
				for _, v9 in pairs(v2:GetDescendants()) do
					if not v9:IsA("ParticleEmitter") or v9.Name ~= "_stand_aura" then
						continue
					end
					v9.Enabled = false
					Debris:AddItem(v9, 3)
				end
			else
				for _, v10 in pairs(v8) do
					v10.Enabled = false
					Debris:AddItem(v10, 3)
				end
			end
		end
	end
}

