-- ReplicatedStorage.src.client.Services.EffectScripts.0.4864216640 [ModuleScript]
return {
	["init_dependencies"] = function() -- name: init_dependencies
		Loader = require(game.ReplicatedStorage.src.Loader)
		ReplicatedStorage = game.ReplicatedStorage
		Lighting = game:GetService("Lighting")
		Players = game:GetService("Players")
		TweenService = game:GetService("TweenService")
		PhysicsService = game:GetService("PhysicsService")
		Debris = game:GetService("Debris")
		RunService = game:GetService("RunService")
		FXUtil = Loader.load_client_service(script, "FXUtil")
		FXServiceClient = Loader.load_client_service(script, "FXServiceClient")
		Units = Loader.load_data(script, "Units")
		SFX = Loader.get_assets_path().sfx
	end,
	["start"] = function(_, p1, p2) -- name: start
		local v3 = p1.unit
		local v4 = Units[v3._stats.id.Value].stand
		v3:FindFirstChild("HumanoidRootPart")
		v3:FindFirstChild("Humanoid")
		local v5 = v3:FindFirstChild(v4)
		local _ = v3._stats:WaitForChild("stand_animation_controller").Value
		local v6 = v5:WaitForChild("HumanoidRootPart")
		FXUtil.hide_model(v5)
		if p2 and p2.play_sound then
			if p2.override_sound == nil then
				FXUtil.play_nonpersistent_sound_at_position(v3:WaitForChild("HumanoidRootPart").Position, "StandSummon")
			else
				FXUtil.play_nonpersistent_sound_at_position(v3:WaitForChild("HumanoidRootPart").Position, p2.override_sound)
			end
		end
		FXUtil.show_model(v5, {
			["tween_time"] = 1
		})
		v6.Transparency = 1
	end
}

