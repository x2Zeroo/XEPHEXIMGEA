-- ReplicatedStorage.src.client.Setup [ModuleScript]
local v1 = {}
Loader = require(game.ReplicatedStorage.src.Loader)
map_loaded = game.workspace:WaitForChild("_MAP_CONFIG"):WaitForChild("MapLoaded")
local _ = game.Players.LocalPlayer
function v1.start_wait_map_loaded_loop() -- name: start_wait_map_loaded_loop
	while not map_loaded.Value do
		task.wait(1)
	end
	while Loader.LevelData == nil do
		Loader.LevelData = game.workspace._MAP_CONFIG:WaitForChild("GetLevelData"):InvokeServer()
		task.wait(1)
	end
end
return v1

