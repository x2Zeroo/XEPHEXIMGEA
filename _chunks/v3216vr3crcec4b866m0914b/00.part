return {
	["init_dependencies"] = function() -- name: init_dependencies
		Loader = require(game.ReplicatedStorage.src.Loader)
		Util = require(game.ReplicatedStorage.src.Util)
		TweenService = game:GetService("TweenService")
	end,
	["init"] = function() -- name: init
		local v1 = workspace._map.misc.portals
		for _, v2 in pairs(v1:GetChildren()) do
			if not v2:IsA("Model") then
				continue
			end
			local v3 = math.random(20, 30) / 10
			for _, v4 in pairs(v2:GetChildren()) do
				TweenService:Create(v4, TweenInfo.new(v3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, true), {
					["Position"] = v4.Position - Vector3.new(0, 10, 0)
				}):Play()
				local v5 = TweenService
				local v6 = TweenInfo.new(v3 * 2, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, true)
				local v7 = {}
				local v8 = v4.Size.X
				local v9 = v4.Size.Y * 0.8
				local v10 = v4.Size.Z
				v7.Size = Vector3.new(v8, v9, v10)
				v5:Create(v4, v6, v7):Play()
			end
		end
	end
}

