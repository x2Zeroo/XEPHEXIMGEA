-- ReplicatedStorage.src.client.Services.EffectScripts.0.9011146233 [ModuleScript]
return {
	["init_dependencies"] = function() -- name: init_dependencies
		Loader = require(game.ReplicatedStorage.src.Loader)
		FXUtil = Loader.load_client_service(script, "FXUtil")
		Lighting = game:GetService("Lighting")
		TweenService = game:GetService("TweenService")
		Debris = game:GetService("Debris")
		RunService = game:GetService("RunService")
		FXServiceClient = Loader.load_client_service(script, "FXServiceClient")
		DodgedUI = Loader.get_assets_path().dodged_ui
		SFX = Loader.get_assets_path().sfx
	end,
	["start"] = function(p1, p2, _) -- name: start
		local v3 = p2.unit_char
		ui = DodgedUI:Clone()
		Debris:AddItem(ui, 2)
		ui.Parent = v3.HumanoidRootPart
		ui.ExtentsOffsetWorldSpace = Vector3.new(0, -2, 0)
		ui.Frame.GemCost.UIScale.Scale = 0.5
		TweenService:Create(ui.Frame.GemCost, TweenInfo.new(0.5), {
			["TextTransparency"] = 1,
			["TextStrokeTransparency"] = 1
		}):Play()
		TweenService:Create(ui.Frame.GemCost.UIStroke, TweenInfo.new(0.5), {
			["Transparency"] = 1
		}):Play()
		TweenService:Create(ui, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			["ExtentsOffsetWorldSpace"] = Vector3.new(0, 3, 0)
		}):Play()
		TweenService:Create(ui.Frame.GemCost.UIScale, TweenInfo.new(0.1, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out, 0, false, 0), {
			["Scale"] = 1
		}):Play()
		FXUtil.play_nonpersistent_sound_at_position(v3.HumanoidRootPart.Position, "dodge")
		if v3.Name == "goku_ui" then
			FXServiceClient.start_fx_client(p1, "mesh_shadow", {
				["user"] = v3
			}, {
				["initial_color"] = Color3.fromRGB(0, 255, 255)
			})
			return
		elseif v3.Name == "diavolo" then
			FXServiceClient.start_fx_client(p1, "mesh_shadow", {
				["user"] = v3
			}, {
				["initial_color"] = Color3.fromRGB(255, 0, 0),
