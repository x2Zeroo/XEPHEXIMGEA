-- Players.xnon5555.PlayerScripts.TournamentTieBreakStudioTest [LocalScript]
if not game:GetService("RunService"):IsStudio() then
	return
end
if not workspace:WaitForChild("_MAP_CONFIG"):WaitForChild("IsLobby").Value then
	return
end
local v1 = os.clock()
while workspace:GetAttribute("_STUDIO_TIEBREAK_TEST") == nil and os.clock() - v1 < 10 do
	task.wait(0.5)
end
if not workspace:GetAttribute("_STUDIO_TIEBREAK_TEST") then
	return
end
local v2 = game:GetService("ReplicatedStorage"):WaitForChild("src")
local v3 = v2:WaitForChild("client"):WaitForChild("Services")
local v4 = require(v3:WaitForChild("TournamentServiceClient"))
local v5 = require(v3:WaitForChild("GUIService"))
local v6 = require(v2:WaitForChild("core"):WaitForChild("Services"):WaitForChild("TournamentServiceCore"))
while true do
	local v7 = v4.session
	local v8 = v4._TOURNAMENT and (v7 and v7.profile_data)
	if v8 then
		v8 = v5.tournament_ranking_ui
	end
	if v8 then
		task.wait(3)
		local v9 = v4._TOURNAMENT
		local v10 = game:GetService("Players").LocalPlayer.UserId
		v6.FIRST_TIEBREAK_WEEK = 0
		v9.score_type = "kills"
		v4.session.profile_data.tournament_data.tournament_scores[v9.tournament_id] = {
			["high_score"] = 672,
			["high_score_damage"] = 1240000000
		}
		local v11 = v5.tournament_ranking_ui
		v11:on_tournament_changed(v9, v4._LEVEL_TEMPLATE_ID, v4._PREVIOUS_TOURNAMENT)
		local v12 = {
			{
				["key"] = 1,
				["value"] = nil,
				["value"] = v6.ranked_score(673, 900000000, true)
			},
			{
				["key"] = 156,
				["value"] = nil,
				["value"] = v6.ranked_score(672, 1500000000, true)
			},
			{
				["key"] = v10,
				["value"] = v6.ranked_score(672, 1240000000, true)
			},
			{
				["key"] = 261,
				["value"] = nil,
				["value"] = v6.ranked_score(672, 800000000, true)
			},
			{
				["key"] = 2,
				["value"] = nil,
				["value"] = v6.ranked_score(670, 3100000000, true)
			},
			{
				["key"] = 3,
				["value"] = nil,
				["value"] = v6.ranked_score(670, 2200000000, true)
			}
		}
		table.sort(v12, function(p13, p14)
			return p13.value > p14.value
		end)
		v11:on_update_leaderboard(v12)
		v11:on_tournament_ranking_updated(0.97, 3)
		print("[TIEBREAK TEST] tournament panel faked as a kills tie-break week (client only). Open the Tournament panel")
		return
	end
	task.wait(1)
end

