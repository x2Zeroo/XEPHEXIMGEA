local v1 = {
	{
		["message"] = "A water goddess like me, scared of a thunderstorm? You must be joking! ...",
		["weight"] = 1
	},
	{
		["message"] = "Bring me back something nice from the Summer Hunt, okay? A goddess needs her offerings!",
		["weight"] = 1
	}
}
local v2 = {
	{
		["message"] = "Have you seen anyone around with lightning powers and a god complex? No? Looks like we\'re safe to keep using his ship for now...",
		["weight"] = 1
	},
	{
		["message"] = "Clear a few Sky Portals and maybe you can afford to tip your navigator!",
		["weight"] = 1
	}
}
local v3 = {
	{
		["message"] = "Oh! H-hi! Sorry, I wasn\'t staring, your Defenses just look really strong today! ...Is it warm out here, or is it just me?",
		["weight"] = 1
	},
	{
		["message"] = "I had nineteen rice cakes for breakfast! You have to keep your strength up to fight demons, okay?",
		["weight"] = 1
	},
	{
		["message"] = "Every night those four demons walk in together like best friends... It\'s kind of sweet! Well, until they merge. Then it\'s just scary!",
		["weight"] = 1
	}
}
local v4 = {
	{
		["message"] = "...Huh? Sorry. I forgot you were here.",
		["weight"] = 1
	},
	{
		["message"] = "You want to help defend? Okay. Bring Defenses. More than that...",
		["weight"] = 1
	},
	{
		["message"] = "The mist is nice. You can\'t see the demons coming. They can\'t see you either. It\'s fair.",
		["weight"] = 1
	},
	{
		["message"] = "Someone told me the moon turns red sometimes. The demons get really strong when it does.",
		["weight"] = 1
	}
}
