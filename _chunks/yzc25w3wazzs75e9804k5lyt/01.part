return game:GetService("HttpService"):JSONDecode("[\n  {\n    \"Key\": \"portal.title\",\n    \"String\": \"Title\",\n    \"EN\": \"Play The Hatch!\",\n    \"IT\": \"The Hatch is on\",\n    \"DE\": \"Spiele the Hatch!\",\n    \"FR\": \"Joue \195\160 L\'\195\169closion\",\n    \"ES\": \"Juega a La eclosi\195\179n\",\n    \"ID\": \"Mainkan The Hatch\",\n    \"TH\": \"\224\185\128\224\184\165\224\185\136\224\184\153 The Hatch!\",\n    \"KO\": \"\235\141\148 \237\149\180\236\185\152\'\235\165\188 \237\148\140\235\160\136\236\157\180\237\149\152\236\132\184\236\154\148!\",\n    \"JA\": \"\227\128\142\227\130\182\227\131\187\227\131\143\227\131\131\227\131\129\227\128\143\227\130\146\227\131\151\227\131\172\227\130\164\239\188\129\",\n    \"ZH\": \"\229\143\130\229\138\160\227\128\138\229\173\181\229\140\150\228\185\139\230\151\133\227\128\139\239\188\129\"\n  },\n  {\n    \"Key\": \"portal.subtitle\",\n    \"String\": \"Sub Title\",\n    \"EN\": \"Ready to crack into this event?\",\n    \"IT\": \"Pronti a smanettare in questo evento?\",\n    \"DE\": \"Ei, das Event kann losgehen!\",\n    \"FR\": \"Pr\195\170t \195\160 te lancer dans cet \195\169v\195\168nement ?\",\n    \"ES\": \"\194\191Tienes ganas de empezar la b\195\186squeda?\",\n    \"ID\": \"Siap Pecahkan Keseruannya?\",\n    \"TH\": \"\224\184\158\224\184\163\224\185\137\224\184\173\224\184\161\224\184\165\224\184\184\224\184\162\224\184\129\224\184\180\224\184\136\224\184\129\224\184\163\224\184\163\224\184\161\224\184\153\224\184\181\224\185\137\224\185\129\224\184\165\224\185\137\224\184\167\224\184\171\224\184\163\224\184\183\224\184\173\224\184\162\224\184\177\224\184\135?\",\n    \"KO\": \"\236\157\180\235\178\164\237\138\184\236\151\144 \235\155\176\236\150\180\235\147\164 \236\164\128\235\185\132\234\176\128 \235\144\152\236\133\168\235\130\152\236\154\148?\",\n    \"JA\": \"\227\130\164\227\131\153\227\131\179\227\131\136\227\129\171\229\143\130\229\138\160\227\129\151\227\129\190\227\129\153\227\129\139\239\188\159\",\n    \"ZH\": \"\229\135\134\229\164\135\229\165\189\232\184\143\228\184\138\232\191\153\230\172\161\230\180\187\229\138\168\231\154\132\230\151\133\233\128\148\228\186\134\229\144\151\239\188\159\"\n  },\n  {\n    \"Key\": \"portal.description-a\",\n    \"String\": \"Description\",\n    \"EN\": \"Join {b}The Hatch Roblox event experience{/b} to {b}earn, trade,{/b} and {b}merge unique eggs{/b} from all your favorite experiences!\",\n    \"IT\": \"Partecipa {b}all\'esperienza evento Roblox The Hatch per ottenere, scambiare e unire uova originali{/b} da tutte le tue esperienze preferite!\",\n    \"DE\": \"Mach mit bei der {b}Roblox Event-Experience \\\"The Hatch\\\"{/b}, um {b}einzigartige Eier{/b} aus all deinen Lieblingsspielen {b}zu verdienen, zu tauschen{/b} und zu {b}verschmelzen{/b}!\",\n    \"FR\": \"Rejoins {b}l\'exp\195\169rience-\195\169v\195\169nement L\'\195\169closion de Roblox pour gagner, \195\169changer{/b} et {b}fusionner des \197\147ufs uniques{/b} issus de toutes tes exp\195\169riences pr\195\169f\195\169r\195\169es !\",\n    \"ES\": \"\195\154nete a la {b}experiencia de evento de Roblox La eclosi\195\179n{/b} para ganar, intercambiar, fusionar huevos \195\186nicos de tus experiencias favoritas.\",\n    \"ID\": \"Bergabunglah ke {b}The Hatch, Pengalaman Virtual Acara Roblox{/b}, untuk {b}mendapatkan, menukar{/b}, dan {b}menggabungkan telur unik{/b} dari semua pengalaman virtual favoritmu.\",\n    \"TH\": \"\224\185\128\224\184\130\224\185\137\224\184\178\224\184\163\224\185\136\224\184\167\224\184\161{b}\224\184\155\224\184\163\224\184\176\224\184\170\224\184\154\224\184\129\224\184\178\224\184\163\224\184\147\224\185\140\224\184\129\224\184\180\224\184\136\224\184\129\224\184\163\224\184\163\224\184\161 The Hatch \224\184\154\224\184\153 Roblox{/b} \224\185\128\224\184\158\224\184\183\224\185\136\224\184\173{b}\224\184\163\224\184\177\224\184\154 \224\185\129\224\184\165\224\184\129\224\185\128\224\184\155\224\184\165\224\184\181\224\185\136\224\184\162\224\184\153 \224\185\129\224\184\165\224\184\176\224\184\156\224\184\170\224\184\178\224\184\153\224\185\132\224\184\130\224\185\136\224\184\170\224\184\184\224\184\148\224\184\158\224\184\180\224\185\128\224\184\168\224\184\169{/b}\224\184\136\224\184\178\224\184\129\224\184\155\224\184\163\224\184\176\224\184\170\224\184\154\224\184\129\224\184\178\224\184\163\224\184\147\224\185\140\224\185\130\224\184\155\224\184\163\224\184\148\224\184\130\224\184\173\224\184\135\224\184\132\224\184\184\224\184\147!\",\n    \"KO\": \"Roblox\236\157\152 \'\235\141\148 \237\149\180\236\185\152\' \236\157\180\235\178\164\237\138\184 \236\178\180\237\151\152\236\151\144 \236\176\184\234\176\128\237\149\180 \235\139\164\236\150\145\237\149\156 \236\157\184\234\184\176 \236\178\180\237\151\152\236\151\144\236\132\156 \237\138\185\235\179\132\237\149\156 \236\151\144\234\183\184\235\165\188 \237\154\141\235\147\157\237\149\152\234\179\160, \234\177\176\235\158\152\237\149\152\234\179\160, \237\149\169\236\185\152\236\132\184\236\154\148!\",\n    \"JA\": \"\227\131\173\227\131\150\227\131\173\227\131\131\227\130\175\227\130\185\233\150\139\229\130\172\227\130\164\227\131\153\227\131\179\227\131\136\227\128\129\227\128\142\227\130\182\227\131\187\227\131\143\227\131\131\227\131\129\227\128\143\227\129\171\229\143\130\229\138\160\227\129\151\227\129\166\227\128\129\227\129\138\230\176\151\227\129\171\229\133\165\227\130\138\227\129\174\227\131\144\227\131\188\227\131\129\227\131\163\227\131\171\231\169\186\233\150\147\227\129\167\227\131\166\227\131\139\227\131\188\227\130\175\227\129\170\227\130\191\227\131\158\227\130\180\227\130\146\231\141\178\229\190\151\227\129\151\227\129\166\227\128\129\229\143\150\229\188\149\239\188\136\227\131\136\227\131\172\227\131\188\227\131\137\239\188\137\227\129\151\227\129\159\227\130\138\227\128\129\229\144\136\228\189\147\227\129\149\227\129\155\227\129\190\227\129\151\227\130\135\227\129\134\239\188\129\",\n    \"ZH\": \"\229\138\160\229\133\165 Roblox \231\154\132\227\128\138\229\173\181\229\140\150\228\185\139\230\151\133\227\128\139\230\180\187\229\138\168\239\188\140\230\148\182\233\155\134\227\128\129\228\186\164\230\152\147\229\185\182\232\158\141\229\144\136\228\189\160\230\156\128\229\150\156\230\172\162\230\184\184\230\136\143\228\189\147\233\170\140\228\184\173\231\154\132\231\139\172\231\137\185\229\189\169\232\155\139\239\188\129\"\n  },\n  {\n    \"Key\": \"portal.description-b\",\n    \"String\": \"\",\n    \"EN\": \"Eggs {b}will not be earnable{/b} by joining the experiences from the homepage. Take a portal from the event back to this experience when ready to hunt.\",\n    \"IT\": \"{b}Non sar\195\160 possibile ottenere uova{/b} partecipando alle esperienze dalla homepage. Usa un portale dall\'evento per raggiungere queste esperienze quando siete pronti per la caccia.\",\n    \"DE\": \"Du kannst Eier {b}nicht verdienen{/b}, wenn du Spielen von der Startseite aus beitrittst. Geh durch ein Portal vom Event zu diesen Experiences, wenn du bereit bist zur Suche.\",\n    \"FR\": \"Les \197\147ufs {b}ne peuvent pas \195\170tre gagn\195\169s{/b} en rejoignant les exp\195\169riences depuis la page d\'accueil. Utilise un portail depuis l\'\195\169v\195\169nement pour acc\195\169der \195\160 ces exp\195\169riences lorsque tu es pr\195\170t \195\160 partir \195\160 la chasse.\",\n    \"ES\": \"{b}No ganar\195\161s huevos{/b} si te unes a las experiencias desde la p\195\161gina de Inicio. Entra a los portales de las experiencias en el Evento para empezar a buscar.\",\n    \"ID\": \"Telur {b}tidak bisa ditemukan{/b} kalau kamu bergabung ke pengalaman virtual dari beranda. Kalau kamu sudah siap, masuk melalui portal acara ini untuk bergabung ke pengalaman virtual untuk berburu telur.\",\n    \"TH\": \"\224\184\132\224\184\184\224\184\147{b}\224\184\136\224\184\176\224\185\132\224\184\161\224\185\136\224\184\170\224\184\178\224\184\161\224\184\178\224\184\163\224\184\150\224\184\163\224\184\177\224\184\154{/b}\224\185\132\224\184\130\224\185\136\224\185\132\224\184\148\224\185\137\224\184\136\224\184\178\224\184\129\224\184\129\224\184\178\224\184\163\224\185\128\224\184\130\224\185\137\224\184\178\224\184\163\224\185\136\224\184\167\224\184\161\224\184\155\224\184\163\224\184\176\224\184\170\224\184\154\224\184\129\224\184\178\224\184\163\224\184\147\224\185\140\224\184\156\224\185\136\224\184\178\224\184\153\224\184\151\224\184\178\224\184\135\224\184\171\224\184\153\224\185\137\224\184\178\224\184\171\224\184\165\224\184\177\224\184\129\224\185\130\224\184\148\224\184\162\224\184\149\224\184\163\224\184\135 \224\185\130\224\184\155\224\184\163\224\184\148\224\185\131\224\184\138\224\185\137\224\184\158\224\184\173\224\184\163\224\185\140\224\184\151\224\184\177\224\184\165\224\185\131\224\184\153\224\184\129\224\184\180\224\184\136\224\184\129\224\184\163\224\184\163\224\184\161\224\185\128\224\184\158\224\184\183\224\185\136\224\184\173\224\185\132\224\184\155\224\184\162\224\184\177\224\184\135\224\184\155\224\184\163\224\184\176\224\184\170\224\184\154\224\184\129\224\184\178\224\184\163\224\184\147\224\185\140 \224\185\128\224\184\161\224\184\183\224\185\136\224\184\173\224\184\132\224\184\184\224\184\147\224\184\158\224\184\163\224\185\137\224\184\173\224\184\161\224\184\151\224\184\181\224\185\136\224\184\136\224\184\176\224\184\173\224\184\173\224\184\129\224\184\149\224\184\178\224\184\161\224\184\171\224\184\178\224\185\132\224\184\130\224\185\136\224\185\129\224\184\165\224\185\137\224\184\167\",\n    \"KO\": \"\237\153\136\237\142\152\236\157\180\236\167\128\236\151\144\236\132\156 \236\178\180\237\151\152\236\151\144 \236\176\184\234\176\128\237\149\152\235\138\148 \234\178\131\235\167\140\236\156\188\235\161\156\235\138\148 \236\151\144\234\183\184 \237\154\141\235\147\157\236\157\180 \235\182\136\234\176\128\235\138\165\237\149\169\235\139\136\235\139\164. \236\157\180\235\178\164\237\138\184\236\151\144\236\132\156 \236\157\180 \236\