			["message"] = "My, you\'ve come to climb? How brave. I\'ll keep a bed ready in the clinic for you, just in case.",
			["weight"] = 1
		},
		{
			["message"] = "I\'m far too small to cut through a demon\'s neck, you see. So I poison them instead. It works just as well. Better, really.",
			["weight"] = 1
		},
		{
			["message"] = "I smile at every demon I meet. I\'d so love for us all to be friends. ...They never take me up on it. Such a shame.",
			["weight"] = 1
		},
		{
			["message"] = "Angry? Me? Not at all! Now go on up and give the demons my regards.",
			["weight"] = 1
		}
	},
	["options"] = {
		{
			["color"] = nil,
			["option_dialogue"] = "[View Event Tower]",
			["open_simple_ui"] = nil,
