			local v48 = {}
			local v49 = p47.normal_num(p46.strikes.min, p46.strikes.max) + 0.5
			v48.strikes = math.floor(v49)
			return v48
		end,
		["_generate_description_text"] = function(p50) -- name: _generate_description_text
			return string.format("<stroke color=\"#ab3900\"><b>+Wrath:</b></stroke> Every %d <b><i>strikes</i></b>, the next <b><i>strike</i></b> gains +100%% Crit Chance", p50.strikes)
		end,
		["_apply_at_relic_setup"] = function(p51) -- name: _apply_at_relic_setup
			local v52 = p51.unique_params
			p51.unit_instance_data.charged_attack_buffs.from_relics[p51.relic_uuid] = {
				["_type"] = "strike",
				["strikes"] = nil,
				["_level"] = "strike",
				["last_time"] = nil,
				["extra_hit_mods"] = nil,
				["_repeats"] = true,
				["_persistent_effect"] = "pfx_lostvayne_aura",
				["strikes"] = v52.strikes,
				["last_time"] = tick(),
				["extra_hit_mods"] = {
					{
						["_extra_crit_chance"] = 1
					}
				}
			}
		end
	},
	["switchblade"] = {
		["id"] = "switchblade",
		["_generate_unique_params"] = nil,
		["_generate_description_text"] = nil,
		["_apply_at_buff"] = nil,
		["_generate_unique_params"] = function(p53, p54) -- name: _generate_unique_params
			return {
				["p"] = p54.normal_num(p53.p.min, p53.p.max)
			}
		end,
		["_generate_description_text"] = function(p55) -- name: _generate_description_text
			local v56 = 0.00007 + p55.p * 0.00007
			return string.format("<stroke color=\"#ab3900\"><b>+Thousand Stings:</b></stroke> Dismembering a Boss makes all <b><i>strikes</i></b> deal +%.3g%% of their current health as True Damage", v56 * 100)
		end,
		["_apply_at_buff"] = function(p57) -- name: _apply_at_buff
			local v58 = {}
			if p57.buff_config and p57.buff_config.name == "dismember" then
				local v59 = p57.target
				if not game:GetService("CollectionService"):HasTag(v59, "bosses") then
					return {}
				end
				local v60 = 0.00007 + p57.unique_params.p * 0.00007
				if v59 and not v59:GetAttribute("_strike_current_hp") then
					v59:SetAttribute("_strike_current_hp", v60)
				end
			end
			return v58
		end
	}
}
return v61

