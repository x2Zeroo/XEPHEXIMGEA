local v146 = {
	["main_dialogue"] = "I see. The true Soul Orb must have brought you to me. It has a will of its own, after all. Do you see it in the middle of this room?",
	["dialogue_line_colors"] = nil,
	["options"] = nil,
	["dialogue_line_colors"] = {
		Color3.fromRGB(154, 45, 227),
		Color3.fromRGB(154, 45, 227),
