			["next"] = 3
		}
	}
}
local v147 = {
	["main_dialogue"] = "The Soul Orb has the ability to manifest one\'s inner desires into reality. It is currently fused within me, but I have made it visible to you.",
	["dialogue_line_colors"] = nil,
	["options"] = nil,
	["dialogue_line_colors"] = {
		Color3.fromRGB(154, 45, 227),
		Color3.fromRGB(154, 45, 227),
		Color3.fromRGB(154, 45, 227),
		Color3.fromRGB(154, 45, 227),
		Color3.fromRGB(154, 45, 227),
		Color3.fromRGB(154, 45, 227)
	},
	["options"] = {
		{
			["option_dialogue"] = "[Continue]",
			["next"] = 4
		}
	}
}
local v148 = {
	["main_dialogue"] = "As I am currently sealed, I cannot act upon my own desires and crush those who seek to control me. Will you help me?",
	["dialogue_line_colors"] = nil,
	["options"] = nil,
	["dialogue_line_colors"] = {
		Color3.fromRGB(154, 45, 227),
