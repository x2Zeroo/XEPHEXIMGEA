				["extra_damage"] = p20.normal_num(p19.extra_damage.min, p19.extra_damage.max)
			}
		end,
		["_generate_description_text"] = function(p21) -- name: _generate_description_text
			return string.format("<stroke color=\"#ab3900\"><b>+Final Hour:</b></stroke> Every %.1fs, the next Magic attack deals %d%% extra True Damage", p21.time_interval, p21.extra_damage * 100)
		end,
		["_apply_at_relic_setup"] = function(p22) -- name: _apply_at_relic_setup
			local v23 = p22.unique_params
			local v24 = p22.unit_instance_data.charged_attack_buffs.from_relics
			local v25 = p22.relic_uuid
			local v26 = {
				["_type"] = "time",
				["cooldown"] = nil,
				["last_time"] = nil,
				["extra_hit_mods"] = nil,
				["_repeats"] = true,
