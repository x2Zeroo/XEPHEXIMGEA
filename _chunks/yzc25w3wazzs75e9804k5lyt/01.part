local v61 = {
	["asta_clover"] = {
		["id"] = "asta_clover",
		["_generate_unique_params"] = nil,
		["_generate_description_text"] = nil,
		["_apply_at_damage_type_buff"] = nil,
		["_generate_unique_params"] = function(p1, p2) -- name: _generate_unique_params
			return {
				["dmg_buff"] = p2.normal_num(p1.dmg_buff.min, p1.dmg_buff.max)
			}
		end,
		["_generate_description_text"] = function(p3) -- name: _generate_description_text
			return string.format("<stroke color=\"#ab3900\"><b>+Anti-Magic:</b></stroke> Cannot deal Magic Damage. +%d%% Physical Damage against enemies with Magic Resistance", p3.dmg_buff * 100)
		end,
		["_apply_at_damage_type_buff"] = function(p4) -- name: _apply_at_damage_type_buff
			for v5, v6 in pairs(p4.damage_type_data) do
				if v6._base_damage_type ~= "magic" then
					continue
				end
				table.remove(p4.damage_type_data, v5)
			end
			local v7 = p4.target_stats:GetAttribute("_dmg_res_magic")
			if v7 and v7 > 0 then
				p4._add_damage_type_buff("physical", {
					["mul"] = p4.unique_params.dmg_buff
				})
			end
		end
	},
	["yuno_clover"] = {
		["id"] = "yuno_clover",
		["_generate_unique_params"] = nil,
		["_generate_description_text"] = nil,
		["_apply_at_damage_type_buff"] = nil,
		["_generate_unique_params"] = function(p8, p9) -- name: _generate_unique_params
			return {
				["dmg_buff"] = p9.normal_num(p8.dmg_buff.min, p8.dmg_buff.max)
			}
		end,
		["_generate_description_text"] = function(p10) -- name: _generate_description_text
			return string.format("<stroke color=\"#ab3900\"><b>+Fairy Blessing:</b></stroke> +%d%% Magic Damage against Flying enemies", p10.dmg_buff * 100)
		end,
		["_apply_at_damage_type_buff"] = function(p11) -- name: _apply_at_damage_type_buff
			if p11.target and p11.target:HasTag("units_with_passive__Flying") then
				p11._add_damage_type_buff("magic", {
					["mul"] = p11.unique_params.dmg_buff
				})
			end
		end
	},
	["noelle_crown"] = {
		["id"] = "noelle_crown",
		["_generate_unique_params"] = nil,
		["_generate_description_text"] = nil,
		["_apply_at_damage_type_buff"] = nil,
		["_generate_unique_params"] = function(p12, p13) -- name: _generate_unique_params
			return {
				["magic_res_decr"] = p13.normal_num(p12.magic_res_decr.min, p12.magic_res_decr.max)
			}
		end,
		["_generate_description_text"] = function(p14) -- name: _generate_description_text
			return string.format("<stroke color=\"#ab3900\"><b>+Sea Serpent\'s Boon:</b></stroke> Each Water Damage hit reduces the enemy\'s Magic Resistance by %.1f", p14.magic_res_decr)
		end,
		["_apply_at_damage_type_buff"] = function(p15) -- name: _apply_at_damage_type_buff
			local v16 = false
			for _, v17 in pairs(p15.damage_type_data) do
				local v18 = v17._secondary_damage_types
				if not (v18 and v18.water_damage) then
					continue
				end
				v16 = true
			end
			if v16 then
				p15._shred_damage_type_modifier(p15.target_stats, "_dmg_res_magic", p15.unique_params.magic_res_decr)
			end
		end
	},
	["hourglass_relic"] = {
		["id"] = "hourglass_relic",
		["_generate_unique_params"] = nil,
		["_generate_description_text"] = nil,
